# ============================================================================
# p2d2 – Basis-Template für Umgebungsvariablen
# ============================================================================
# HINWEIS:
# - Die Datei wird NICHT direkt verwendet.
# - Admins/DevOps kopieren daraus Variablen in die jeweiligen .env*-Dateien.
# - Secrets NIEMALS in Git committen.
# ============================================================================

# Debug-Flag (public)
# false = Produktionsmodus, true = zusätzliche Logs
APP_DEBUG=false

# Default-Icon für Kategorien (public, muss existierende Datei im public/-Baum sein)
DEFAULT_CATEGORY_ICON=/images/icons/default-category.svg

# ----------------------------------------------------------------------------
# Datenbank – globale Einstellungen (alle Stages)
# Hostname oder IP der PostgreSQL-Instanz
# Port der PostgreSQL-Instanz
# Name der PostgreSQL-Datenbank (nicht das Schema)
# ----------------------------------------------------------------------------
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=data-dna

# ----------------------------------------------------------------------------
# Datenbank – stage-spezifische Einstellungen (pro .env.<stage>)
# DB_USER und # DB_PASSWORD werden in .env.<stage> (z.B. .env.de1) definiert
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# WFS-T – globale Einstellungen
# Globale WFS-T Endpoint-URL (server-side)
# Namespace für WFS-T Features
# Globale WFS-Endpoint-URL für den Client (wfs-auth.ts)
# ----------------------------------------------------------------------------
WFST_ENDPOINT=https://wfs.data-dna.eu/geoserver/ows
WFST_NAMESPACE=urn:data-dna:govdata

PUBLIC_WFST_ENDPOINT=https://wfs.data-dna.eu/geoserver/ows

# ----------------------------------------------------------------------------
# WFS-T – stage-spezifische Einstellungen (pro .env.<stage>)
# ----------------------------------------------------------------------------
# WFST_WORKSPACE – GeoServer-Workspace je Stage, z.B.:
#   production: Verwaltungsdaten
#   develop:    Verwaltungsdaten_develop
#   de1:        Verwaltungsdaten_de1
#   de2:        Verwaltungsdaten_de2
#   fv:         Verwaltungsdaten_fv
# PUBLIC_WFST_WORKSPACE und WFST_USERNAME / WFST_PASSWORD
# werden in .env.<stage> definiert

# ----------------------------------------------------------------------------
# Kontakt & SMTP – globale Struktur (Werte je Stage/Instanz abweichend)
# ALTCHA_HMAC_KEY – Secret für ALTCHA Captcha
# SMTP Konfiguration
# Absender/Empfänger für Kontaktformular
# ----------------------------------------------------------------------------
ALTCHA_HMAC_KEY=CHANGEME

SMTP_HOST=mail.example.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGEME
SMTP_PASS=CHANGEME

CONTACT_EMAIL_TO=kontakt@example.org
CONTACT_EMAIL_FROM=no-reply@example.org
