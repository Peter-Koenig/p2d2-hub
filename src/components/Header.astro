---
import { getUserSession } from "../lib/auth/session";
const userSession = getUserSession(Astro.locals);
const canShowVerwaltung =
    userSession.isAuthenticated && userSession.roles.includes("verwaltung");
const canShowOsm =
    userSession.isAuthenticated && userSession.roles.includes("osm");

const nav = [
    {
        name: "Entdecken",
        href: "/#entdecken",
        key: "entdecken",
        ariaLabel: "p2d2 entdecken",
        explanation: "p2d2 entdecken",
    },
    {
        name: "Mitmachen",
        href: "/mitmachen",
        key: "mitmachen",
        ariaLabel: "Bei p2d2 mitmachen",
        explanation: "Bei p2d2 mitmachen",
    },
    {
        name: "Für ÖV",
        href: "/fuer-oev",
        key: "fuer-oev",
        ariaLabel: "Für die Öffentliche Verwaltung",
        explanation: "Für die Öffentliche Verwaltung",
    },
    {
        name: "Für OSM",
        href: "/fuer-osm",
        key: "fuer-osm",
        ariaLabel: "Für die OSM-Community",
        explanation: "Für die OSM-Community",
    },
    {
        name: "Über p2d2",
        key: "about",
        ariaLabel: "Über p2d2",
        explanation: "Über p2d2",
        children: [
            { name: "Hintergrund", href: "/ueber/hintergrund" },
            { name: "Ziel", href: "/ueber/ziel" },
            { name: "Status", href: "/ueber/status" },
            { name: "Umsetzung", href: "/ueber/umsetzung" },
            { name: "Zukunft", href: "/ueber/zukunft" },
            { name: "Tests", href: "/ueber/testen" },
        ],
    },
    { name: "Kontakt", href: "/kontakt", key: "kontakt", ariaLabel: "Kontakt zu p2d2", explanation: "Kontakt zu p2d2" },
    ...(canShowVerwaltung
        ? [{ name: "Verwaltung", href: "/verwaltung", key: "verwaltung" }]
        : []),
    ...(canShowOsm ? [{ name: "OSM", href: "/osm", key: "osm" }] : []),
];

const currentPath = Astro.url.pathname;

// Hilfsfunktion für aktive Links
function isActive(item: {
    href?: string;
    name: string;
    children?: { name: string; href: string }[];
}) {
    if (!item.href) return false;
    return item.href === "/"
        ? currentPath === "/"
        : currentPath.startsWith(item.href);
}

// userSession wurde bereits weiter oben definiert
const initials = userSession.isAuthenticated
    ? (userSession.displayName ?? userSession.userName ?? "?")
          .split(" ")
          .map((w: string) => w?.charAt(0)?.toUpperCase() ?? "")
          .slice(0, 2)
          .join("")
    : "";
