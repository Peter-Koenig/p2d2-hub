---
import { getCollection } from "astro:content";
import KommunenClickHandler from "../utils/kommunen-click-handler";

const kommunen = await getCollection("kommunen");
const sorted = kommunen.sort(
    (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

// Create client-side accessible kommune data map
const kommuneDataMap: Record<
    string,
    { wpName: string; osmAdminLevels: number[] }
> = {};
kommunen.forEach((kommune) => {
    kommuneDataMap[kommune.slug] = {
        wpName: kommune.data.wp_name, // KORRIGIERT: wpName statt wp_name
        osmAdminLevels: kommune.data.osmAdminLevels || [],
    };
});
---

<div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 items-stretch max-w-5xl mx-auto py-12 mb-section"
    data-kommune-map={JSON.stringify(kommuneDataMap)}
>
    {
        sorted.map((entry) => {
            const m = entry.data.map || {};
            const detail = {
                center: m.center,
                extent: m.extent,
                zoom: m.zoom,
                projection: m.projection,
                extra: m.extra,
                slug: entry.slug,
            };

            // Validate data before dispatch
            const hasValidCenter =
                detail.center &&
                Array.isArray(detail.center) &&
                detail.center.length === 2 &&
                detail.center.every(Number.isFinite);
            const hasValidExtent =
                detail.extent &&
                Array.isArray(detail.extent) &&
                detail.extent.length === 4 &&
                detail.extent.every(Number.isFinite);
            const hasValidZoom = detail.zoom && Number.isFinite(detail.zoom);

            if (!hasValidCenter && !hasValidExtent) {
                console.warn(
                    "[kommunen] invalid data for dispatch - missing both center and extent",
                    { slug: entry.slug, detail },
                );
            }
            const colorStripe = entry.data.colorStripe ?? "#FF6900";

            return (
                <button
                    type="button"
                    class="kommunen-card relative bg-white rounded-xl border border-gray-200 shadow-lg overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl group text-left w-full h-full flex flex-col"
                    style={`--color-stripe: ${colorStripe}`}
                    aria-label={`Kommune ${entry.data.title} auswählen`}
                    data-slug={entry.slug}
                    data-detail={JSON.stringify(detail)}
                    data-kommune-slug={entry.slug}
                >
                    <div class="absolute -inset-2 z-0 pointer-events-none">
                        <div class="w-full h-full mx-auto opacity-30 blur-lg filter bg-gradient-to-r from-gray-200 to-gray-50 pointer-events-none" />
                    </div>

                    <div
                        class="absolute top-0 left-0 w-full h-1.5 z-10"
                        style={`background-color: ${colorStripe}`}
                    />

                    <div class="relative z-10 p-6 pt-6 flex flex-col items-start gap-3">
                        <h3 class="font-poppins font-bold text-xl mt-2">
                            {entry.data.title}
                        </h3>
                        <div class="font-inter text-base text-gray-700 leading-tight">
                            {entry.body
                                ? entry.body
                                : `Entdecke Projekte in ${entry.data.title}`}
                        </div>
                    </div>

                    <div class="absolute inset-0 pointer-events-none rounded-xl transition-all duration-300 group-hover:shadow-[0_0_32px_4px_rgba(255,105,0,0.3)] z-10" />
                </button>
            );
        })
    }
</div>

<script>
    import KommunenClickHandler from "../utils/kommunen-click-handler";

    let kommunenHandler: KommunenClickHandler | null = null;
    let isHandlerBound = false;

    if (typeof window !== "undefined") {
        if (!(window as any).__p2d2KommunenHandlerBound && !isHandlerBound) {
            (window as any).__p2d2KommunenHandlerBound = true;
            isHandlerBound = true;

            const initHandler = () => {
                kommunenHandler = new KommunenClickHandler();
                kommunenHandler.bind();
                // ENTFERNT: addWFSLayerToggleHandler(); - war redundant!
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initHandler);
            } else {
                setTimeout(initHandler, 100);
            }

            // Cleanup für HMR
            if (typeof import.meta !== "undefined" && import.meta.hot) {
                import.meta.hot.dispose(() => {
                    if (kommunenHandler) {
                        kommunenHandler.unbind();
                        kommunenHandler = null;
                    }
                    (window as any).__p2d2KommunenHandlerBound = false;
                    isHandlerBound = false;
                });
            }
        }
    }
</script>
