<!-- p2d2: Werte-Raster: Transparenz, Gemeinschaft, Offene Daten -->
---
import { getCollection } from "astro:content";
import Werte from "./Werte.astro";

const werte = await getCollection("werte");
const sorted = werte.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Link-Ziele positionsbasiert nach order (statt aus der Content Collection):
// Karte 1 → /mitmachen, Karte 2 → /fuer-oev, Karte 3 → /fuer-osm
const werteLinks: Record<number, string> = {
    1: "/mitmachen",
    2: "/fuer-oev",
    3: "/fuer-osm",
};
---

<h2
    class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center"
>
    Ein Thema. Eine Kommune. Viele Perspektiven.
</h2>
<p
    class="text-lg text-gray-700 max-w-3xl mx-auto text-center leading-relaxed mb-4"
>
    p2d2 beginnt dort, wo ein Thema vor Ort wichtig ist – und lädt je nach
    Perspektive zu unterschiedlichen Beteiligungswegen ein.
</p>

<div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-5xl mx-auto py-12"
>
    {
        sorted
            .slice(0, 12)
            .map((entry) => (
                <Werte
                    title={entry.data.title}
                    icon={entry.data.icon}
                    description={entry.body}
                    href={werteLinks[entry.data.order ?? 0]}
                />
            ))
    }
</div>
