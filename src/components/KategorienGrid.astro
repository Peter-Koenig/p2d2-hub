---
import { getCollection } from "astro:content";
import Kategorien from "./Kategorien.astro";

const kategorien = await getCollection("kategorien");
const sorted = kategorien.sort(
    (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<script>
    import { dispatchThrottledEvent } from "../utils/events";

    let isHandlerBound = false;

    if (typeof window !== "undefined") {
        if (!(window as any).__p2d2KategorienHandlerBound && !isHandlerBound) {
            (window as any).__p2d2KategorienHandlerBound = true;
            isHandlerBound = true;

            const handleCategoryClick = (event: MouseEvent) => {
                console.log("[DEBUG] Raw category click detected:", {
                    target: event.target,
                    currentTarget: event.currentTarget,
                    bubbles: event.bubbles,
                });

                console.log("[DEBUG] Category click detected:", event.target);
                console.log("[DEBUG] Event path:", event.composedPath());

                const target = event.target as HTMLElement;

                // KRITISCH: Native Links nicht blockieren!
                if (target.closest("a[href]")) {
                    return; // Native navigation erlauben
                }

                // Nur auf Kategorie-Cards reagieren
                const button = target.closest(
                    "button.kategorie-card",
                ) as HTMLButtonElement | null;

                if (!button) {
                    console.log(
                        "[DEBUG] No kategorie-card button found, ignoring",
                    );
                    return;
                }

                console.log("[DEBUG] Found kategorie-card button:", button);

                // Event nur für unsere Buttons stoppen
                event.preventDefault();
                event.stopPropagation();

                console.log("[kategorien] Click event detected, processing...");

                if (button) {
                    const categorySlug = button.dataset.categorySlug;
                    console.log("[DEBUG] Found category slug:", categorySlug);
                    if (!categorySlug) {
                        console.warn("[kategorien] No category slug found");
                        return;
                    }
                    console.log(
                        "[kategorien] Processing click for:",
                        categorySlug,
                    );

                    dispatchThrottledEvent("ui:select-category", {
                        categorySlug,
                    });
                    console.log("[kategorien] Event dispatched successfully");
                }
            };

            // Verwende spezifischen Container statt document
            const initEventHandler = () => {
                // Spezifischer Selector für Kategorien-Grid
                const kategorienGrid = document.querySelector(
                    "#kategorien-grid .grid",
                );
                console.log(
                    "[DEBUG] Kategorien grid container found:",
                    !!kategorienGrid,
                );

                if (kategorienGrid) {
                    kategorienGrid.addEventListener(
                        "click",
                        handleCategoryClick,
                        { passive: false }, // Damit preventDefault funktioniert
                    );
                    console.log(
                        "[DEBUG] Kategorien event handler bound successfully",
                    );
                } else {
                    console.warn(
                        "[kategorien] Kategorien grid container not found, using document fallback",
                    );
                    document.addEventListener("click", handleCategoryClick);
                }
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initEventHandler);
            } else {
                setTimeout(initEventHandler, 100);
            }

            // HMR Cleanup
            if (typeof import.meta !== "undefined" && import.meta.hot) {
                import.meta.hot.dispose(() => {
                    const kategorienGrid = document.querySelector(
                        "#kategorien-grid .grid",
                    );
                    if (kategorienGrid) {
                        kategorienGrid.removeEventListener(
                            "click",
                            handleCategoryClick,
                        );
                    }
                    (window as any).__p2d2KategorienHandlerBound = false;
                    isHandlerBound = false;
                });
            }
        }
    }
</script>

<div
    id="kategorien-grid"
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-5xl mx-auto py-12 mb-section"
>
    {
        sorted
            .slice(0, 12)
            .map((entry) => (
                <Kategorien
                    title={entry.data.title}
                    icon={entry.data.icon}
                    description={entry.data.description}
                    id={`modal-${entry.slug}`}
                    slug={entry.slug}
                />
            ))
    }
</div>
