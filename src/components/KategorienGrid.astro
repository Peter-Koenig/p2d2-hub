---
import { getCollection } from "astro:content";
import Kategorien from "./Kategorien.astro";

const kategorien = await getCollection("kategorien");
const sorted = kategorien.sort(
    (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<script>
    import { dispatchThrottledEvent } from "../utils/events";

    let isHandlerBound = false;

    if (typeof window !== "undefined") {
        if (!(window as any).__p2d2KategorienHandlerBound && !isHandlerBound) {
            (window as any).__p2d2KategorienHandlerBound = true;
            isHandlerBound = true;

            const handleCategoryClick = (event: MouseEvent) => {
                // KRITISCH: Native Links nicht blockieren!
                if (
                    event.target instanceof Element &&
                    event.target.closest("a[href]")
                ) {
                    return; // Native navigation erlauben
                }

                // Nur auf spezifische Kategorie-Cards reagieren
                const button = (event.target as HTMLElement).closest(
                    "button.kategorie-card",
                ) as HTMLButtonElement | null;

                if (!button) return;

                // Verhindere Default-Verhalten nur für Kategorie-Cards
                event.preventDefault();
                event.stopPropagation();

                console.log(
                    "[kategorien] Click event detected, event-Bulleing?",
                );

                if (button) {
                    const categorySlug = button.dataset.categorySlug;
                    if (!categorySlug) {
                        console.warn("[kategorien] No category slug found");
                        return;
                    }
                    console.log(
                        "[kategorien] Processing click for:",
                        categorySlug,
                    );

                    dispatchThrottledEvent("ui:select-category", {
                        categorySlug,
                    });
                    console.log("[kategorien] Event dispatched successfully");
                }
            };

            // Verwende spezifischen Container statt document
            const gridContainer = document.querySelector(".grid.grid-cols-1");
            if (gridContainer) {
                gridContainer.addEventListener("click", handleCategoryClick);
            } else {
                console.warn(
                    "[kategorien] Grid container not found for event binding",
                );
            }

            // HMR Cleanup
            if (typeof import.meta !== "undefined" && import.meta.hot) {
                import.meta.hot.dispose(() => {
                    const gridContainer =
                        document.querySelector(".grid.grid-cols-1");
                    if (gridContainer) {
                        gridContainer.removeEventListener(
                            "click",
                            handleCategoryClick,
                        );
                    }
                    (window as any).__p2d2KategorienHandlerBound = false;
                    isHandlerBound = false;
                });
            }
        }
    }
</script>

<div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-5xl mx-auto py-12 mb-section"
>
    {
        sorted
            .slice(0, 12)
            .map((entry) => (
                <Kategorien
                    title={entry.data.title}
                    icon={entry.data.icon}
                    description={entry.data.description}
                    id={`modal-${entry.slug}`}
                    slug={entry.slug}
                />
            ))
    }
</div>
