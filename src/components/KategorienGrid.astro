<!-- p2d2: Rasteransicht der Themenkategorien -->
---
import { getCollection } from "astro:content";
import Kategorien from "./Kategorien.astro";

const kategorien = await getCollection("kategorien");
const sorted = kategorien.sort(
    (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<script>
    import { mapState } from "../utils/map-state";
    import { dispatchP2D2Event, P2D2EventType } from "../utils/events";

    // Global window interface extensions
    interface Window {
        wfsManager: any;
    }

    // Phase 2: Event handler for category selection
    let isHandlerBound = false;

    if (typeof window !== "undefined" && !isHandlerBound) {
        const handleCategoryClick = async (event: MouseEvent) => {
            const target = event.target as HTMLElement;
            const button = target.closest(
                "[data-category-slug]",
            ) as HTMLElement;

            if (button) {
                const categorySlug = button.getAttribute("data-category-slug");
                if (categorySlug) {
                    console.log("[DEBUG] Category clicked:", categorySlug);

                    // Toggle-Logik: Wenn gleiche Kategorie nochmal geklickt → deaktivieren
                    const currentCategory = mapState.getSelectedCategory();

                    if (currentCategory === categorySlug) {
                        // Highlighting entfernen
                        button.classList.remove("highlighted");

                        // Aus mapState entfernen
                        mapState.setSelectedCategory(null);

                        // WFS-Layer wird jetzt reaktiv über WFSLayerManager + mapState gemanaged

                        console.log(
                            "[KategorienGrid] Kategorie deselektiert:",
                            categorySlug,
                        );
                        return;
                    }

                    // Alle anderen Buttons deselektieren
                    document
                        .querySelectorAll("[data-category-slug]")
                        .forEach((btn) => btn.classList.remove("highlighted"));
                    // Highlight selected button
                    button.classList.add("highlighted");

                    // ✅ KRITISCH: Kategorie-State setzen BEVOR WFS-Toggle!
                    mapState.setSelectedCategory(categorySlug);
                    console.log(
                        "[KategorienGrid] Kategorie ausgewählt:",
                        categorySlug,
                    );

                    console.log(
                        "[DEBUG] Selected category set to:",
                        mapState.getSelectedCategory(),
                    );

                    // Dispatch event for scrolling back to header (disable throttling)
                    dispatchP2D2Event(
                        P2D2EventType.CATEGORY_SELECTED,
                        {
                            categorySlug,
                            timestamp: Date.now(),
                        },
                        { throttleMs: 0 },
                    );

                    // FALLBACK: Direct scroll call (if event system is too slow)
                    setTimeout(() => {
                        if (
                            typeof (window as any).scrollToSelectionHeader ===
                            "function"
                        ) {
                            (window as any).scrollToSelectionHeader();
                        }
                    }, 350);

                    // Logging für Debugging
                    const currentKommune = mapState.getSelectedKommune();
                    console.log("[UI] Category selected:", {
                        categorySlug,
                        currentKommune: currentKommune?.slug,
                        timestamp: Date.now(),
                    });
                }
            }
        };

        // Bind event listener
        document.addEventListener("click", handleCategoryClick);
        isHandlerBound = true;
    }
</script>

<div
    id="kategorien-grid"
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 items-stretch max-w-5xl mx-auto py-12 mb-section"
>
    {
        sorted
            .slice(0, 12)
            .map((entry) => (
                <Kategorien
                    title={entry.data.title}
                    icon={entry.data.icon}
                    description={entry.data.description}
                    id={`modal-${entry.slug}`}
                    slug={entry.slug}
                    imageVersion={entry.data.image_version}
                />
            ))
    }
</div>
