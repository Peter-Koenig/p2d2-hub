---
import { getCollection } from "astro:content";
import Kategorien from "./Kategorien.astro";

const kategorien = await getCollection("kategorien");
const sorted = kategorien.sort(
    (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<script>
    import { mapState } from "../utils/map-state";

    // Global window interface extensions
    interface Window {
        wfsManager: any;
    }

    // Phase 2: Event handler for category selection
    let isHandlerBound = false;

    if (typeof window !== "undefined" && !isHandlerBound) {
        const handleCategoryClick = async (event: MouseEvent) => {
            const target = event.target as HTMLElement;
            const button = target.closest(
                "[data-category-slug]",
            ) as HTMLElement;

            if (button) {
                const categorySlug = button.getAttribute("data-category-slug");
                if (categorySlug && (window as any).wfsManager) {
                    // Get current selected kommune from mapState
                    const currentKommune = mapState.getSelectedKommune();

                    if (currentKommune) {
                        await (window as any).wfsManager.toggleLayer(
                            currentKommune,
                            categorySlug,
                        );
                    } else {
                        console.warn(
                            "[WFS] No kommune selected for category toggle",
                        );
                    }
                }
            }
        };

        // Bind event listener
        document.addEventListener("click", handleCategoryClick);
        isHandlerBound = true;
    }
</script>

<div
    id="kategorien-grid"
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-5xl mx-auto py-12 mb-section"
>
    {
        sorted
            .slice(0, 12)
            .map((entry) => (
                <Kategorien
                    title={entry.data.title}
                    icon={entry.data.icon}
                    description={entry.data.description}
                    id={`modal-${entry.slug}`}
                    slug={entry.slug}
                />
            ))
    }
</div>
