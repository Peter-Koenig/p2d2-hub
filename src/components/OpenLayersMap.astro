---
import MapCanvas from "./MapCanvas.astro";
---

<div class="w-full mb-section">
    <h2
        id="kommune-kategorie-header"
        class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center"
    >
        <a
            href="#kommunen-grid"
            onclick="handleKommuneClick(event)"
            class="text-orange-400 hover:text-orange-500 underline decoration-2 underline-offset-4 hover:decoration-4 transition-colors duration-200 font-bold"
            >Kommune</a
        > / <a
            href="#kategorien-grid"
            onclick="handleKategorieClick(event)"
            class="text-green-400 hover:text-green-500 underline decoration-2 underline-offset-4 hover:decoration-4 transition-colors duration-200 font-bold"
            >Kategorie</a
        > auswählen und los gehts!
    </h2>
    <div
        class="w-full h-[30rem] text-lg text-grey-900 mb-8 text-center relative"
    >
        <main class="w-full h-full">
            <MapCanvas />
        </main>
    </div>

    <script is:inline>
        function handleKommuneClick(e) {
            e.preventDefault();
            const gridContainer = document.getElementById("grid-container");
            if (gridContainer) {
                gridContainer.scrollIntoView({ behavior: "smooth" });
            }
            // Try to use global switchTab function if available
            if (typeof window.switchTab === "function") {
                window.switchTab("kommunen");
            } else {
                const kommunenTab = document.querySelector(
                    '.tab-button[data-tab="kommunen"]',
                );
                if (kommunenTab) {
                    kommunenTab.click();
                }
            }
        }

        function handleKategorieClick(e) {
            e.preventDefault();
            const gridContainer = document.getElementById("grid-container");
            if (gridContainer) {
                gridContainer.scrollIntoView({ behavior: "smooth" });
            }
            // Try to use global switchTab function if available
            if (typeof window.switchTab === "function") {
                window.switchTab("kategorien");
            } else {
                const kategorienTab = document.querySelector(
                    '.tab-button[data-tab="kategorien"]',
                );
                if (kategorienTab) {
                    kategorienTab.click();
                }
            }
        }

        function scrollToSelectionHeader() {
            requestAnimationFrame(() => {
                // Finde das Map-Element
                const mapElement = document.getElementById("map");

                if (mapElement) {
                    // Dynamisch: Berechne tatsächliche Header-Höhe (fixed header)
                    const headerElement = document.querySelector("header");
                    const headerHeight = headerElement
                        ? headerElement.offsetHeight
                        : 80;
                    const padding = 16; // 16px Abstand zwischen Header und Karte

                    const elementPosition =
                        mapElement.getBoundingClientRect().top;
                    const offsetPosition =
                        elementPosition +
                        window.pageYOffset -
                        headerHeight -
                        padding;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: "smooth",
                    });

                    console.log(
                        `[OpenLayersMap] Scrolled to map (header: ${headerHeight}px, padding: ${padding}px)`,
                    );
                    return;
                }

                // Fallback: Zum Kommune/Kategorie-Header scrollen
                const header = document.getElementById(
                    "kommune-kategorie-header",
                );
                if (header) {
                    const headerElement = document.querySelector("header");
                    const headerHeight = headerElement
                        ? headerElement.offsetHeight
                        : 80;
                    const padding = 16;

                    const elementPosition = header.getBoundingClientRect().top;
                    const offsetPosition =
                        elementPosition +
                        window.pageYOffset -
                        headerHeight -
                        padding;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: "smooth",
                    });

                    console.log(
                        `[OpenLayersMap] Fallback: Scrolled to header (header: ${headerHeight}px)`,
                    );
                } else {
                    console.warn(
                        "[OpenLayersMap] Neither map nor header found",
                    );
                }
            });
        }

        // Listen for selection events to scroll back to header
        if (typeof window !== "undefined") {
            // When a kommune is selected
            window.addEventListener("p2d2:kommunen:focus", () => {
                console.log(
                    "[OpenLayersMap] Kommune selected - scrolling to map section",
                );
                setTimeout(scrollToSelectionHeader, 300);
            });

            // When a category is selected
            window.addEventListener("p2d2:category:selected", () => {
                console.log(
                    "[OpenLayersMap] Category selected - scrolling to map section",
                );
                setTimeout(scrollToSelectionHeader, 300);
            });

            // Also expose globally for direct calls
            window.scrollToSelectionHeader = scrollToSelectionHeader;

            console.log("[OpenLayersMap] Scroll event listeners registered");
        }
    </script>
</div>
