---
import { Content as HeroContent } from "../content/hero.md";
---

<style>
    :global(.hero-section h1) {
        font-family: "Poppins", sans-serif;
        font-weight: 800;
        font-size: 3.75rem;
    }
    .entwurf-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5; /* Unterhalb des Hero-Contents, aber über dem Video */
    }
    .entwurf-ecke {
        position: absolute;
        color: #39ff14;
        font-size: 2rem;
        font-weight: bold;
        text-shadow:
            0 0 8px #39ff14,
            2px 2px 6px #000;
        opacity: 0.7;
        user-select: none;
    }

    .entwurf-ecke.tl {
        top: 60px;
        left: 5px;
        transform: rotate(315deg);
    }
    .entwurf-ecke.tr {
        top: 50px;
        right: 5px;
        transform: rotate(45deg);
    }
    .entwurf-ecke.bl {
        bottom: 50px;
        left: 5px;
        transform: rotate(225deg);
    }
    .entwurf-ecke.br {
        bottom: 50px;
        right: 5px;
        transform: rotate(135deg);
    }
</style>

<section class="hero-section relative w-full h-[30rem] mb-section mt-6">
    {/* Video-Container mit konsistenter Breite wie die Karte */}
    <div class="w-full h-full flex items-center justify-center">
        {/* Äußerer Container für Schatten und maximale Breite */}
        <div
            class="w-[95%] max-w-[95%] mx-auto rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_0_20px_rgba(1,67,33,0.8)]"
        >
            {/* Innerer Container für Video-Clipping */}
            <div
                class="w-full h-[30rem] overflow-hidden rounded-2xl md:rounded-3xl"
            >
                <video
                    class="w-full h-full object-cover"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster="/images/hero-fallback.jpg"
                >
                    <source src="/videos/hero-bg.webm" type="video/webm" />
                    <source src="/videos/hero-bg.mp4" type="video/mp4" />
                    Ihr Browser unterstützt das Video-Tag nicht.
                </video>
            </div>
        </div>
    </div>

    {/* Content-Overlay - absolut positioniert über dem Video */}
    <div class="absolute inset-0 z-10 flex items-center justify-center">
        <div
            class="leading-none hero-section relative flex flex-col items-center justify-center text-center text-white bg-black/40 p-8 rounded-lg max-w-3xl mx-auto"
        >
            <HeroContent />
            {/* Overlay mit "Entwurf" in den vier Ecken */}
            <div class="entwurf-overlay">
                <span class="entwurf-ecke tl">Pre-MVP</span>
                <span class="entwurf-ecke tr">Pre-MVP</span>
                <span class="entwurf-ecke bl">Pre-MVP</span>
                <span class="entwurf-ecke br">Pre-MVP</span>
            </div>
        </div>
    </div>
</section>
