---
import { Content as HeroContent } from "../content/hero.md";
---

<style>
    :global(.hero-section h1) {
        font-family: "Poppins", sans-serif;
        font-weight: 800;
        font-size: 2.5rem; /* Base size for mobile */
    }

    .entwurf-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5; /* Unterhalb des Hero-Contents, aber über dem Video */
    }

    .entwurf-ecke {
        position: absolute;
        color: #39ff14;
        font-size: 1.25rem; /* Smaller for mobile */
        font-weight: bold;
        text-shadow:
            0 0 6px #39ff14,
            1px 1px 4px #000;
        opacity: 0.7;
        user-select: none;
    }

    .entwurf-ecke.tl {
        top: 10px;
        left: 5px;
        transform: rotate(315deg);
    }

    .entwurf-ecke.tr {
        top: 10px;
        right: 5px;
        transform: rotate(45deg);
    }

    .entwurf-ecke.bl {
        bottom: 10px;
        left: 5px;
        transform: rotate(225deg);
    }

    .entwurf-ecke.br {
        bottom: 10px;
        right: 5px;
        transform: rotate(135deg);
    }

    /* Desktop styles */
    @media (min-width: 768px) {
        :global(.hero-section h1) {
            font-size: 3.75rem; /* Larger for desktop */
        }

        .entwurf-ecke {
            font-size: 2rem; /* Larger for desktop */
            text-shadow:
                0 0 8px #39ff14,
                2px 2px 6px #000;
        }

        .entwurf-ecke.tl,
        .entwurf-ecke.tr {
            top: 20px;
        }

        .entwurf-ecke.bl,
        .entwurf-ecke.br {
            bottom: 20px;
        }

        .entwurf-ecke.tl,
        .entwurf-ecke.bl {
            left: 10px;
        }

        .entwurf-ecke.tr,
        .entwurf-ecke.br {
            right: 10px;
        }
    }
</style>

<section
    class="hero-section relative w-full h-[20rem] md:h-[30rem] mb-section mt-6"
>
    {/* Video-Container mit konsistenter Breite wie die Karte */}
    <div class="w-full h-full flex items-center justify-center">
        {/* Äußerer Container für Schatten und maximale Breite */}
        <div
            class="w-full max-w-full px-4 md:px-0 md:w-[95%] md:max-w-[95%] mx-auto rounded-xl md:rounded-2xl lg:rounded-3xl overflow-hidden shadow-[0_0_15px_rgba(1,67,33,0.7)] md:shadow-[0_0_20px_rgba(1,67,33,0.8)]"
        >
            {/* Innerer Container für Video-Clipping */}
            <div
                class="w-full h-[20rem] md:h-[30rem] overflow-hidden rounded-xl md:rounded-2xl lg:rounded-3xl"
            >
                <video
                    class="w-full h-full object-cover"
                    autoplay
                    loop
                    muted
                    playsinline
                    poster="/images/hero-fallback.jpg"
                >
                    <source src="/videos/hero-bg.webm" type="video/webm" />
                    <source src="/videos/hero-bg.mp4" type="video/mp4" />
                    Ihr Browser unterstützt das Video-Tag nicht.
                </video>
            </div>
        </div>
    </div>

    {/* Content-Overlay - absolut positioniert über dem Video */}
    <div class="absolute inset-0 z-10 flex items-center justify-center">
        <div
            class="leading-none hero-section relative flex flex-col items-center justify-center text-center text-white bg-black/40 p-4 md:p-8 rounded-lg max-w-[90%] sm:max-w-3xl mx-auto"
        >
            <HeroContent />
            {/* Overlay mit "Entwurf" in den vier Ecken */}
            <div class="entwurf-overlay">
                <span class="entwurf-ecke tl">MVP</span>
                <span class="entwurf-ecke tr">MVP</span>
                <span class="entwurf-ecke bl">MVP</span>
                <span class="entwurf-ecke br">MVP</span>
            </div>
        </div>
    </div>
</section>
