---
interface Props {
    // Props can be added later if needed for customization
}
---

<div class="nav-controls">
    <button id="nav-back" class="nav-btn" title="Zurück (Alt+←)" disabled>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
        </svg>
    </button>
    <button id="nav-forward" class="nav-btn" title="Vor (Alt+→)" disabled>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
        </svg>
    </button>
</div>

<script>
    import {
        goBack,
        goForward,
        initNavigationControls,
    } from "@/utils/map-navigation.ts";

    /**
     * Wartet passiv auf Map-Initialisierung via Polling
     * Retry-Strategie: Alle 50ms prüfen, max 100 Versuche (= 5 Sekunden)
     */
    function waitForMapAndInitialize() {
        const maxRetries = 100;
        let retryCount = 0;

        function checkMapAvailability() {
            const map = window.featureEditorMap;

            if (map) {
                // ✅ Map ist verfügbar → Initialisierung starten
                console.log(
                    "NavigationControls: Map ready, initializing controls",
                );

                // ViewHistoryManager initialisieren (für Vor/Zurück-Buttons)
                initNavigationControls(map);

                // Event-Listener für alle Buttons binden
                const backBtn = document.getElementById("nav-back");
                const forwardBtn = document.getElementById("nav-forward");

                if (backBtn)
                    backBtn.addEventListener("click", () => goBack(map));
                if (forwardBtn)
                    forwardBtn.addEventListener("click", () => goForward(map));

                console.log(
                    "NavigationControls: All event listeners bound successfully",
                );
            } else {
                // ⏳ Map noch nicht verfügbar → erneut prüfen
                retryCount++;

                if (retryCount < maxRetries) {
                    setTimeout(checkMapAvailability, 50); // Retry nach 50ms
                } else {
                    console.error(
                        "NavigationControls: Timeout waiting for featureEditorMap (5 seconds)",
                    );
                }
            }
        }

        // Start der Initialisierung
        checkMapAvailability();
    }

    // Start nach DOMContentLoaded ODER sofort, falls DOM bereits ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", waitForMapAndInitialize);
    } else {
        // DOM bereits ready → sofort starten
        waitForMapAndInitialize();
    }
</script>

<style>
    .nav-controls {
        position: absolute;
        top: 0.5rem;
        left: 2.5rem;
        display: flex;
        gap: 0.5rem;
        z-index: 1000;
    }

    .nav-btn {
        width: 20px;
        height: 20px;
        background: white;
        border: none;
        border-radius: 0.25rem;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .nav-btn:hover:not(:disabled) {
        background: #dc2626;
        color: white;
        transform: scale(1.05);
    }

    .nav-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .nav-btn svg {
        width: 10px;
        height: 10px;
    }

    @media (max-width: 768px) {
        .nav-controls {
            top: 0.75rem;
            left: 0.75rem;
        }

        .nav-btn {
            width: 18px;
            height: 18px;
        }

        .nav-btn svg {
            width: 9px;
            height: 9px;
        }
    }

    @media (prefers-contrast: high) {
        .nav-btn {
            border: 1px solid #374151;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-btn {
            transition: none;
        }

        .nav-btn:hover:not(:disabled) {
            transform: none;
        }
    }
</style>
