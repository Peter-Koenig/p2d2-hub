---
interface Props {
    friedhofName?: string;
}

const { friedhofName = "Unbekannter Friedhof" } = Astro.props;

// Vermeide doppelte "Friedhof:"-Präfixe
const displayFriedhofName = friedhofName.startsWith("Friedhof:")
    ? friedhofName
    : `Friedhof: ${friedhofName}`;
---

<header class="feature-editor-header">
    <!-- Links: Logo + p2d2 (KEIN LINK) -->
    <div class="logo-container">
        <img src="/images/logo.svg" alt="p2d2 Logo" class="logo" />
        <span class="brand-name">p2d2</span>
    </div>

    <!-- Mitte: Friedhof-Name (zentriert) -->
    <h1 class="friedhof-title">
        {displayFriedhofName}
    </h1>

    <!-- Rechts: Schließen-Button -->
    <button
        id="close-editor-btn"
        class="close-btn"
        aria-label="Editor schließen"
    >
        Schließen
    </button>
</header>

<style>
    .feature-editor-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        padding: 1rem 1.5rem;
        /* Gleicher Hintergrund wie Hauptfenster-Header */
        background: rgba(240, 253, 244, 0.9); /* Tailwind green-50/90 */
        border-bottom: 1px solid #bbf7d0; /* Tailwind green-200 */
        gap: 1rem;
        position: relative;
        z-index: 50;
    }

    /* Logo + p2d2 (links) - KEIN LINK MEHR */
    .logo-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .logo {
        height: 2rem;
        width: auto;
    }

    .brand-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #14532d; /* Tailwind green-800 für guten Kontrast */
    }

    /* Friedhof-Name (zentriert) */
    .friedhof-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #14532d; /* Tailwind green-800 für guten Kontrast */
        text-align: center;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Schließen-Button (rechts) */
    .close-btn {
        padding: 0.5rem 1rem;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 0.375rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
        font-size: 0.875rem;
        white-space: nowrap;
    }

    .close-btn:hover {
        background: #b91c1c;
    }

    .close-btn:active {
        transform: scale(0.98);
    }

    /* Mobile Anpassungen */
    @media (max-width: 768px) {
        .feature-editor-header {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
            padding: 0.75rem 1rem;
            gap: 0.75rem;
        }

        /* Zeile 1: Logo (links) + Schließen-Button (rechts) */
        .logo-container {
            grid-column: 1;
            grid-row: 1;
        }

        .close-btn {
            grid-column: 1;
            grid-row: 1;
            justify-self: end;
            align-self: center;
            padding: 0.375rem 0.75rem;
        }

        /* Zeile 2: Friedhof-Name (zentriert, volle Breite) */
        .friedhof-title {
            grid-column: 1;
            grid-row: 2;
            font-size: 1rem;
        }

        .logo {
            height: 1.5rem;
        }

        .brand-name {
            font-size: 1.25rem;
        }
    }
</style>

<script>
    document
        .getElementById("close-editor-btn")
        ?.addEventListener("click", () => {
            // Prüfe auf ungespeicherte Änderungen (mit Fallback)
            const hasDirtyFeatures =
                (document.body.dataset.hasDirtyFeatures ?? "false") === "true";

            if (hasDirtyFeatures) {
                const confirmed = confirm(
                    "Sie haben ungespeicherte Änderungen. Wirklich schließen?",
                );
                if (!confirmed) return;
            }

            // Zurück zur vorherigen Seite (schließt Editor-Fenster)
            window.close();

            // Fallback falls window.close() nicht funktioniert (z.B. bei non-popup windows)
            if (!window.closed) {
                window.history.back();
            }
        });
</script>
