<!-- p2d2: Kategorien-Hero-Card mit Foto und Gradient -->
---
import Modal from "./Modal.astro";

interface Props {
  title: string;
  icon: string;
  description: string;
  id: string;
  slug: string;
  imageVersion?: string;
}
const { title, icon, description, id, slug, imageVersion = "001" } = Astro.props;

const imgSrc = `/images/kategorien/${slug}_${imageVersion}.jpg`;
---

<button
    type="button"
    class="kategorie-card relative bg-white rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl group text-left w-full h-[280px]"
    data-category-slug={slug}
    aria-label={`Kategorie ${title} auswählen`}
>
    <!-- Foto als Hintergrund -->
    <div class="absolute inset-0 z-0">
        <img
            src={imgSrc}
            alt={title}
            class="w-full h-full object-cover object-center"
            onerror="this.style.display='none'; this.parentElement.style.background='#2a2a2a'"
        />
    </div>

    <!-- Gradient: transparent → dunkle Farbe -->
    <div
        class="absolute inset-0 z-10"
        style="background: linear-gradient(to bottom, transparent 30%, #074220f5 70%)"
    >
    </div>

    <!-- Grüner Streifen oben -->
    <div class="absolute top-0 left-0 w-full h-1.5 bg-[#0FF078] z-20"></div>

    <!-- Titel + Beschreibung unten -->
    <div class="absolute bottom-0 left-0 right-0 z-20 p-5">
        <h3 class="font-poppins font-bold text-2xl text-white uppercase tracking-wide leading-tight mb-1">
            {title}
        </h3>
        <p class="font-inter text-sm text-gray-300 leading-tight line-clamp-2">
            {description}
        </p>
    </div>

    <!-- Hover-Glow -->
    <div
        class="absolute inset-0 pointer-events-none rounded-xl transition-all duration-300 group-hover:shadow-[0_0_32px_4px_#0a6630] z-30"
    >
    </div>
</button>
