<!-- p2d2: Seiten-Footer: Links, Copyright und Logos -->
---
import { getCollection } from "astro:content";

const socialmedia = await getCollection("socialmedia");
const intern = await getCollection("intern");
const repositories = await getCollection("repositories");

const copyrightEntry = await getCollection("copyright");
const copyright = copyrightEntry[0]?.data.text ?? "";
---

<footer class="bg-green-950 text-gray-100">
    <div
        class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-gray-800 items-start"
    >
        <!-- Links: Logo, Abstract -->
        <div>
            <div class="flex items-center gap-3 mb-3">
                <img
                    src="/images/logo.svg"
                    alt="Public-Public Data-DNA Logo"
                    class="h-15 w-15"
                />
                <span class="font-poppins text-xl font-bold"
                    >Public-Public Data-DNA</span
                >
            </div>
            <p class="mb-4 text-gray-300">
                Das Geheimnis der DNA: Stabilität und Dynamik durch Transparenz
                und das richtige Maß an gegenseitiger Kontrolle von
                Öffentlichkeit und öffentlicher Verwaltung: P2D2 schafft dafür
                die Infrastruktur.
            </p>
            <div class="flex gap-3 space-y-2 mt-4">
                {
                    socialmedia.map((entry) => (
                        <a
                            href={entry.data.url}
                            class="hover:text-green-400 transition"
                            target="_blank"
                            rel="noopener"
                        >
                            <span class="sr-only">{entry.data.name}</span>
                            <img
                                src={`/images/icons/${entry.data.icon}.svg`}
                                alt={entry.data.name}
                                class="h-6 w-6"
                            />
                        </a>
                    ))
                }
            </div>
        </div>
        <!-- Mitte: Interne Links -->
        <div class="mt-4 md:mt-4 md:ml-24">
            <h3 class="font-poppins text-xl font-bold mb-4">Über uns</h3>
            <ul class="space-y-2">
                {
                    intern.map((entry) => (
                        <li>
                            <a
                                href={entry.data.url}
                                class="hover:text-green-400 transition"
                            >
                                {entry.data.name}
                            </a>
                        </li>
                    ))
                }
                <!-- Dokumentation Links -->
                <li>
                    <a
                        href="https://doc.data-dna.eu/de/"
                        class="hover:text-green-400 transition"
                        target="_blank"
                        rel="noopener"
                    >
                        Dokumentation
                    </a>(
                    <a
                        href="https://doc.data-dna.eu/en/"
                        class="hover:text-green-400 transition"
                        target="_blank"
                        rel="noopener"
                    >
                        EN</a
                    > )
                </li>
            </ul>
        </div>
        <!-- Rechts: Ressourcen & Social Media -->
        <div class="mt-4 md:mt-4 flex flex-col">
            <div>
                <h3 class="font-poppins text-xl font-bold mb-4">Ressourcen</h3>
                <ul class="space-y-2 mb-4">
                    <li>
                        <span class="font-semibold">Repositories:</span>
                        {
                            repositories.map((entry, i) => (
                                <span class="ml-2">
                                    <a
                                        href={entry.data.url}
                                        class="hover:text-green-400 transition"
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        {entry.data.name}
                                    </a>
                                    {i < repositories.length - 1 && (
                                        <span class="mx-1">|</span>
                                    )}
                                </span>
                            ))
                        }
                    </li>
                </ul>
            </div>
            <div class="space-y-2">
                <h3 class="font-semibold">
                    <a
                        href="/ueber/partner"
                        class="hover:text-green-400 transition"
                        >Unterstützt durch</a
                    >
                </h3>
                <a href="/ueber/partner">
                    <img
                        src="/images/PTF_BMFTR.png"
                        alt="Protottype Fund und BMFTR"
                        class="block w-full max-w-[300px] mb-2"
                    />
                </a>
                <a href="/ueber/partner">
                    <img
                        src={`/images/FoerderPartner.png`}
                        alt="un:box Cologne, BMWSB"
                        class="block w-full max-w-[300px]"
                    />
                </a>
            </div>
        </div>
    </div>
    <div
        class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center text-sm bg-gray-950"
    >
        <div class="mb-2 md:mb-0 text-gray-400">{copyright}</div>
        <div class="flex gap-4">
            <a href="/legal/impressum" class="hover:text-green-400 transition">Impressum</a>
            <a href="/legal/datenschutz" class="hover:text-green-400 transition">Datenschutz</a>
            <a href="/legal/lizenzen" class="hover:text-green-400 transition">Lizenzen</a>
        </div>
    </div>
</footer>
