---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

const entries: CollectionEntry<"intern">[] = await getCollection("intern");
const entry = entries.find((e) => e.slug === "status");
if (!entry) {
    throw new Error('Kein Eintrag mit Slug "status" in Collection "intern" gefunden.');
}
const { Content } = await render(entry);
const pageTitle = entry.data.name ?? "p2d2";
---

<BaseLayout title={pageTitle}>
    <main class="max-w-4xl mx-auto px-6 py-12 bg-white min-h-screen">
        <Prose>
            <Content />
        </Prose>
    </main>
</BaseLayout>
