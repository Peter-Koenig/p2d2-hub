---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

const { slug } = Astro.params;
const internEntries = await getCollection("intern");
const entry = internEntries.find(
    (item): item is CollectionEntry<"intern"> => item.slug === slug,
);

if (!entry) {
    throw new Error(
        `Kein Eintrag mit Slug "${slug}" in Collection "intern" gefunden.`,
    );
}

const { Content } = await render(entry);
const pageTitle = entry.data.name ?? "p2d2";
---

<BaseLayout title={pageTitle as string}>
    <main class="max-w-4xl mx-auto px-6 py-12 bg-white min-h-screen">
        <Prose>
            <Content />
        </Prose>
    </main>
</BaseLayout>
