<!-- p2d2: Über p2d2: Partner und Förderer -->
---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Partner | p2d2"
    description="Die organisatorischen und finanziellen Partner von p2d2."
>
    <main>
        <!-- Hero-Bereich -->
        <section
            class="w-full bg-gradient-to-r from-primary-600 to-green-500 text-white py-16 px-6 text-center"
        >
            <div class="max-w-4xl mx-auto">
                <h1 class="font-poppins font-bold text-4xl md:text-5xl mb-6">
                    Unsere Partner
                </h1>
                <p
                    class="text-xl leading-relaxed max-w-3xl mx-auto"
                >
                    p2d2 wird durch engagierte Partner organisatorisch und
                    finanziell unterstützt. Wir bedanken uns herzlich.
                </p>
            </div>
        </section>

        <!-- Content -->
        <div class="max-w-5xl mx-auto px-6 py-12">
            <!-- Abschnitt 1: Organisatorische Unterstützung -->
            <h2 class="font-poppins font-bold text-2xl md:text-3xl mb-8">
                Organisatorische Unterstützung
            </h2>

            <!-- Card: unbox cologne -->
            <div class="bg-gray-50 rounded-2xl p-8 mb-8">
                <div class="flex items-center gap-8">
                    <a
                        href="https://www.stadt-koeln.de/leben-in-koeln/unbox-cologne/"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/images/partner/Unbox_Logo.png"
                            alt="unbox cologne"
                            class="max-h-32 w-auto object-contain flex-shrink-0"
                        />
                    </a>
                    <div>
                        <h3 class="font-poppins font-semibold text-xl mb-2">
                            unbox cologne
                        </h3>
                        <p class="text-gray-700 leading-relaxed">
                            Wir bedanken uns beim unbox cologne Team für die
                            tolle Unterstützung beim Integrieren des Projektes
                            in die 2. Runde, die vielen Treffen, Workshops,
                            Anregungen und Hilfestellungen.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card: Prototype Fund -->
            <div class="bg-gray-50 rounded-2xl p-8 mb-8">
                <div class="flex items-center gap-8">
                    <a
                        href="https://prototypefund.de"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/images/PTF_Hoch_Dunkel.svg"
                            alt="Prototype Fund"
                            class="h-20 w-auto object-contain flex-shrink-0"
                        />
                    </a>
                    <div>
                        <h3 class="font-poppins font-semibold text-xl mb-2">
                            Prototype Fund
                        </h3>
                        <p class="text-gray-700 leading-relaxed">
                            Der Prototype Fund fördert Open-Source-Projekte im
                            öffentlichen Interesse. p2d2 wurde als gefördertes
                            Projekt aufgenommen.
                        </p>
                        <p class="text-sm text-gray-500 mt-2">
                            Mastodon:
                            <a
                                href="https://mastodon.social/@PrototypeFund"
                                class="hover:text-primary-600 transition"
                                target="_blank"
                                rel="noopener"
                            >
                                @PrototypeFund@mastodon.social
                            </a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Abschnitt 2: Finanzielle Förderung -->
            <h2
                class="font-poppins font-bold text-2xl md:text-3xl mb-8 mt-16"
            >
                Finanzielle Förderung
            </h2>

            <!-- Card: Stadt Köln -->
            <div class="bg-gray-50 rounded-2xl p-8 mb-8">
                <div class="flex items-center gap-8">
                    <a
                        href="https://www.stadt-koeln.de/"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/images/partner/KOE_VM_Logo.jpg"
                            alt="Stadt Köln"
                            class="h-11 w-auto object-contain flex-shrink-0"
                        />
                    </a>
                    <div>
                        <h3 class="font-poppins font-semibold text-xl mb-2">
                            Stadt Köln
                        </h3>
                        <p class="text-sm text-gray-500 mt-2">
                            Mastodon:
                            <a
                                href="https://social.cologne/@koeln"
                                class="hover:text-primary-600 transition"
                                target="_blank"
                                rel="noopener"
                            >
                                @koeln@social.cologne
                            </a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card: Kreditanstalt für Wiederaufbau (KfW) -->
            <div class="bg-gray-50 rounded-2xl p-8 mb-8">
                <div class="flex items-center gap-8">
                    <a
                        href="https://www.kfw.de"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/images/partner/KfW.png"
                            alt="KfW"
                            class="h-16 w-auto object-contain flex-shrink-0"
                        />
                    </a>
                    <div>
                        <h3 class="font-poppins font-semibold text-xl mb-2">
                            Kreditanstalt für Wiederaufbau (KfW)
                        </h3>
                    </div>
                </div>
            </div>

            <!-- Card: Bundesministerium für Wohnen, Stadtentwicklung und Bauwesen (BMWSB) -->
            <div class="bg-gray-50 rounded-2xl p-8 mb-8">
                <div class="flex items-center gap-8">
                    <a
                        href="https://www.bmwsb.bund.de"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/images/partner/BMWSB.png"
                            alt="BMWSB"
                            class="h-44 w-auto object-contain flex-shrink-0"
                        />
                    </a>
                    <div>
                        <h3 class="font-poppins font-semibold text-xl mb-2">
                            Bundesministerium für Wohnen, Stadtentwicklung und
                            Bauwesen
                        </h3>
                        <p class="text-sm text-gray-500 mt-2">
                            Mastodon:
                            <a
                                href="https://social.bund.de/@BMWSB_Bund"
                                class="hover:text-primary-600 transition"
                                target="_blank"
                                rel="noopener"
                            >
                                @BMWSB_Bund@social.bund.de
                            </a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card: Bundesministerium für Forschung, Technologie und Raumfahrt (BMFTR) -->
            <div class="bg-gray-50 rounded-2xl p-8 mb-8">
                <div class="flex items-center gap-8">
                    <a
                        href="https://www.bundesregierung.de/breg-de/bundesregierung/bundeskanzleramt/staatssekretaer-fuer-forschung-technologie-und-raumfahrt"
                        target="_blank"
                        rel="noopener"
                    >
                        <img
                            src="/images/BMFTR_de.png"
                            alt="BMFTR"
                            class="h-36 w-auto object-contain flex-shrink-0"
                        />
                    </a>
                    <div>
                        <h3 class="font-poppins font-semibold text-xl mb-2">
                            Bundesministerium für Forschung, Technologie und
                            Raumfahrt
                        </h3>
                        <p class="text-sm text-gray-500 mt-2">
                            Mastodon:
                            <a
                                href="https://social.bund.de/@bmftr_bund"
                                class="hover:text-primary-600 transition"
                                target="_blank"
                                rel="noopener"
                            >
                                @bmftr_bund@social.bund.de
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</BaseLayout>
