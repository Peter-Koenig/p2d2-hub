<!-- p2d2: Über p2d2: Technische Umsetzung und Architektur -->
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

const internEntries: CollectionEntry<"intern">[] = await getCollection("intern");
const entry = internEntries.find(
  (item): item is CollectionEntry<"intern"> => item.slug === "umsetzung",
);
if (!entry) {
  throw new Error('Eintrag mit Slug "umsetzung" in Collection "intern" nicht gefunden.');
}
const { Content } = await render(entry);
const pageTitle = entry.data.name ?? "Umsetzung";
---

<BaseLayout title={pageTitle}>
    <main class="max-w-4xl mx-auto px-6 py-12 bg-white min-h-screen">
        <Prose>
            <Content />
        </Prose>
    </main>
</BaseLayout>
