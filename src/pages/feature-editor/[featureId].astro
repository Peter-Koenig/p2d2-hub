---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "../../styles/feature-popup.css";
import "../../styles/feature-editor.css";
import FeatureEditorHeader from "../../components/feature-editor/FeatureEditorHeader.astro";
import NavigationControls from "../../components/feature-editor/NavigationControls.astro";
import LayerControls from "../../components/feature-editor/LayerControls.astro";

const { featureId } = Astro.params;
const wp_name = Astro.url.searchParams.get("wp_name");
const container_type = Astro.url.searchParams.get("container_type");
const name = Astro.url.searchParams.get("name");
const extent = Astro.url.searchParams.get("extent");

// Validate required parameters
if (!wp_name || !container_type || !name || !extent) {
    throw new Error("Missing required URL parameters for feature editor");
}

// ✅ DYNAMISCH: Projektion aus Content-Collection laden
let targetProjection = "EPSG:25832"; // Fallback für Köln

if (wp_name) {
    try {
        const kommunen = await getCollection("kommunen");
        const kommune = kommunen.find((k) => k.data.wpname === wp_name);

        if (kommune?.data.map?.projection) {
            targetProjection = kommune.data.map.projection;
            console.log(
                `Feature-Editor: Using projection ${targetProjection} for ${kommune.data.title}`,
            );
        } else {
            console.warn(
                `Feature-Editor: No projection found for ${wp_name}, using fallback ${targetProjection}`,
            );
        }
    } catch (error) {
        console.error(
            "Feature-Editor: Failed to load kommune projection",
            error,
        );
    }
}

console.log(`Feature-Editor: Target projection is ${targetProjection}`);

// Decode feature name for display
const decodedName = decodeURIComponent(name);
---

<BaseLayout title={`Feature Editor: ${decodedName}`}>
    <div class="feature-editor-container">
        <FeatureEditorHeader
            title={decodedName}
            commune=""
            wpName={wp_name}
            containerType={container_type}
        />

        <div class="editor-content">
            <!-- Map Container -->
            <div class="map-container">
                <div id="feature-editor-map" class="w-full h-full"></div>
                <NavigationControls />
                <LayerControls />
            </div>
        </div>
    </div>

    <script>
        // Client-side logic for feature editor
        import { Map as OLMap, View } from "ol";
        import TileLayer from "ol/layer/Tile";
        import VectorLayer from "ol/layer/Vector";
        import VectorSource from "ol/source/Vector";
        import OSM from "ol/source/OSM";
        import GeoJSON from "ol/format/GeoJSON";
        import { Style, Stroke, Fill, Text } from "ol/style";
        import { transformExtent } from "ol/proj";
        import { defaults } from "ol/control/defaults";
        import FullScreen from "ol/control/FullScreen";
        import TileWMS from "ol/source/TileWMS";

        import { wfsAuthClient } from "@/utils/wfs-auth.ts";
        import { registerUtm } from "@/utils/crs.ts";
        import { fromExtent } from "ol/geom/Polygon";
        import { Feature } from "ol";
        import Overlay from "ol/Overlay";
        import { ViewHistoryManager } from "@/utils/view-history-manager.ts";
        import { calculateUtmResolutions } from "@/utils/utm-resolutions.ts";
        import { initFeatureEditorMap } from "@/utils/map-initializer.ts";
        import { MAP_CONFIG } from "@/config/map-config.ts";
        import { getViewHistoryManager } from "@/utils/map-navigation.ts";

        // Initialize feature editor (wrapped in async IIFE to allow early returns)
        (async () => {
            // Parse URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const wpName = urlParams.get("wp_name");
            const containerType = urlParams.get("container_type");
            const name = urlParams.get("name");
            const extentStr = urlParams.get("extent");
            const projectionParam = urlParams.get("projection");

            // Validate parameters
            if (
                !wpName ||
                !containerType ||
                !name ||
                !extentStr ||
                !projectionParam
            ) {
                console.error(
                    "Feature-Editor: Missing required URL parameters",
                );
                const featureCount = document.getElementById("feature-count");
                if (featureCount) {
                    featureCount.textContent =
                        "Fehler: Benötigte Parameter fehlen (wpName, containerType, name, extent, projection)";
                }
                return; // Now works inside function!
            }

            // Register UTM projection if needed
            const targetProjection = projectionParam || "EPSG:3857";
            if (targetProjection.startsWith("EPSG:258")) {
                try {
                    registerUtm(targetProjection);
                    console.log(
                        `Feature-Editor: Registered UTM projection ${targetProjection}`,
                    );
                } catch (error) {
                    console.error(
                        `Feature-Editor: Failed to register projection ${targetProjection}`,
                        error,
                    );
                }
            }

            // Parse extent (in WGS84) and transform to target projection
            const extent = extentStr.split(",").map(Number);
            const transformedExtent = transformExtent(
                extent,
                "EPSG:4326",
                targetProjection,
            );

            console.log("Feature-Editor: Initialization", {
                wpName,
                containerType,
                name,
                projection: targetProjection,
                extentWGS84: extent,
                extentTransformed: transformedExtent,
            });

            // Initialize map once DOM is ready
            document.addEventListener("DOMContentLoaded", async () => {
                try {
                    // Calculate resolutions using centralized utility
                    const resolutions = calculateUtmResolutions();

                    // Initialize the map
                    const map = initFeatureEditorMap("feature-editor-map");

                    // Store map in global scope for components to access
                    window.featureEditorMap = map;

                    // ✅ KORREKT: Direktes WMS-Layer-Setup wie in alter Version
                    // WICHTIG: targetProjection von Map-View übernehmen
                    const mapProjection = map
                        .getView()
                        .getProjection()
                        .getCode();

                    // Luftbild Köln WMS Layer
                    const luftbildLayer = new TileLayer({
                        source: new TileWMS({
                            url: "https://geoportal.stadt-koeln.de/wss/service/luftbilder_2024_wms/guest",
                            params: {
                                LAYERS: "luftbilder_2024_23",
                                FORMAT: "image/png",
                                TILED: true,
                            },
                            projection: mapProjection, // Dynamisch von Map übernommen
                            crossOrigin: "anonymous",
                            attributions:
                                '<a href="https://www.offenedaten-koeln.de/dataset/luftbilder-koeln-2024" target="_blank">Luftbilder Köln 2024 © Stadt Köln</a>',
                        }),
                        visible: false,
                        opacity: 1.0,
                        zIndex: 10,
                    });
                    map.addLayer(luftbildLayer);
                    window.luftbildLayer = luftbildLayer; // Für LayerControls
                    console.log("Luftbild layer added successfully");

                    // basemap.de WMS Layer
                    const basemapLayer = new TileLayer({
                        source: new TileWMS({
                            url: "https://sgx.geodatenzentrum.de/wms_basemapde",
                            params: {
                                LAYERS: "de_basemapde_web_raster_farbe",
                                FORMAT: "image/png",
                                TRANSPARENT: "true",
                                TILED: true,
                            },
                            projection: "EPSG:3857",
                            crossOrigin: "anonymous",
                            attributions:
                                '© GeoBasis-DE / <a href="https://basemap.de" target="_blank">BKG</a>',
                        }),
                        visible: false,
                        opacity: 1.0,
                        zIndex: 9,
                    });
                    map.addLayer(basemapLayer);
                    window.basemapLayer = basemapLayer; // Für LayerControls
                    console.log("basemap.de layer added successfully");

                    // DEBUGGING: Log map size and extent for initial fit
                    console.log("=== ZOOM DEBUG (Initial Fit) ===");
                    console.log(
                        "Map container size BEFORE update:",
                        map.getSize(),
                    );
                    console.log(
                        "Map target element:",
                        map.getTargetElement()?.offsetWidth,
                        "x",
                        map.getTargetElement()?.offsetHeight,
                    );
                    console.log("Extent to fit:", transformedExtent);

                    // Force map size update
                    map.updateSize();

                    // Wait for size update to complete
                    await new Promise((resolve) => setTimeout(resolve, 50));

                    const actualSize = map.getSize();
                    console.log("Map container size AFTER update:", actualSize);

                    // Fit view to the feature extent
                    map.getView().fit(transformedExtent, {
                        size: actualSize, // Use freshly updated size
                        duration: 500,
                        padding: [20, 20, 20, 20], // 20px Abstand für Luftigkeit
                        constrainResolution: false, // Floating-Point-Zoom erlauben
                        maxZoom: 18,
                    });

                    console.log(
                        "Zoom level after initial fit:",
                        map.getView().getZoom(),
                    );

                    // Force map size update after render
                    setTimeout(() => {
                        map.updateSize();
                        console.log("Feature-Editor: Map size updated");
                    }, 100);

                    console.log("Feature-Editor: Map initialized", {
                        projection: targetProjection,
                        extent: transformedExtent,
                        center: map.getView().getCenter(),
                        zoom: map.getView().getZoom(),
                    });

                    // DEBUG: Check View projection
                    const view = map.getView();
                    const projection = view.getProjection();

                    console.log("=== PROJECTION DEBUG ===");
                    console.log("Projection Code:", projection.getCode());
                    console.log("Projection Units:", projection.getUnits());
                    console.log(
                        "View maxResolution:",
                        view.getMaxResolution(),
                        "(expected: 15000)",
                    );
                    console.log("Resolution at Zoom 15:", resolutions[15]);
                    console.log("Resolution at Zoom 20:", resolutions[20]);
                    console.log("View minResolution:", view.getMinResolution());
                    console.log("View maxZoom:", view.getMaxZoom());
                    console.log("View minZoom:", view.getMinZoom());
                    console.log("=======================");

                    // Load actual cemetery polygon
                    const cemeteryCqlFilter = `osm_admin_level=8 AND wp_name='${wpName}' AND container_type='${containerType}' AND name='${name}'`;
                    console.log(
                        "Feature-Editor: Loading cemetery polygon with filter:",
                        cemeteryCqlFilter,
                    );

                    const cemeteryUrl = wfsAuthClient.buildAuthorizedWFSURL(
                        "p2d2_containers",
                        {
                            CQL_FILTER: cemeteryCqlFilter,
                        },
                    );

                    const cemeteryResponse =
                        await wfsAuthClient.fetchWithAuth(cemeteryUrl);
                    if (!cemeteryResponse.ok) {
                        throw new Error(
                            `WFS request for cemetery failed: ${cemeteryResponse.status}`,
                        );
                    }

                    const cemeteryGeoJson = await cemeteryResponse.json();
                    const cemeteryFeatures = cemeteryGeoJson.features || [];

                    console.log(
                        `Feature-Editor: Loaded ${cemeteryFeatures.length} cemetery features`,
                    );

                    if (cemeteryFeatures.length > 0) {
                        // Parse cemetery geometry
                        const geojsonFormat = new GeoJSON();
                        const cemeteryOlFeatures = geojsonFormat.readFeatures(
                            cemeteryGeoJson,
                            {
                                dataProjection: "EPSG:4326",
                                featureProjection: targetProjection,
                            },
                        );

                        // Create cemetery background layer with orange-red color scheme
                        const CEMETERY_BG_STYLE = new Style({
                            stroke: new Stroke({
                                color: "rgba(194, 65, 12, 0.1)", // ✅ Orange-Rot
                                width: 1,
                            }),
                            fill: new Fill({
                                color: "rgba(234, 88, 12, 0.15)", // ✅ Orange-Rot
                            }),
                        });

                        const cemeteryBgLayer = new VectorLayer({
                            source: new VectorSource({
                                features: cemeteryOlFeatures,
                            }),
                            style: CEMETERY_BG_STYLE,
                            zIndex: MAP_CONFIG.Z_INDEX.CEMETERY_BG,
                        });

                        map.addLayer(cemeteryBgLayer);
                        console.log("Cemetery background layer added");

                        // Load and display grabflur features
                        await loadAndDisplayGrabflurFeatures(
                            map,
                            wpName,
                            containerType,
                            name,
                            targetProjection,
                        );
                    } else {
                        console.warn("No cemetery features found");
                    }
                } catch (error) {
                    console.error(
                        "Feature-Editor: Initialization failed",
                        error,
                    );
                }
            });

            /**
             * Load and display grabflur features for the cemetery
             */
            async function loadAndDisplayGrabflurFeatures(
                map,
                wpName,
                containerType,
                name,
                projection,
            ) {
                try {
                    // ✅ KORREKT: Admin-Level 10, LIKE-Pattern mit Wildcard
                    // Grabflure sind Sub-Features des Hauptfriedhofs, daher höheres Admin-Level (10 statt 8/9)
                    // LIKE-Pattern matcht alle Grabfluren wie "Rheinkassel-001", "Rheinkassel-002" etc.
                    const namePattern = `${name}-%`; // z.B. "Rheinkassel-%"
                    const grabflurCqlFilter = `osm_admin_level=10 AND wp_name='${wpName}' AND container_type='${containerType}' AND name LIKE '${namePattern}'`;

                    console.log(
                        "Feature-Editor: Loading grabflur features with CORRECTED filter:",
                        grabflurCqlFilter,
                    );

                    const grabflurUrl = wfsAuthClient.buildAuthorizedWFSURL(
                        "p2d2_containers",
                        {
                            CQL_FILTER: grabflurCqlFilter,
                        },
                    );

                    const grabflurResponse =
                        await wfsAuthClient.fetchWithAuth(grabflurUrl);
                    if (!grabflurResponse.ok) {
                        throw new Error(
                            `WFS request for grabflur failed: ${grabflurResponse.status}`,
                        );
                    }

                    const grabflurGeoJson = await grabflurResponse.json();
                    const grabflurFeatures = grabflurGeoJson.features || [];

                    console.log(
                        `Feature-Editor: Loaded ${grabflurFeatures.length} grabflur features`,
                    );

                    if (grabflurFeatures.length > 0) {
                        // Parse grabflur geometries
                        const geojsonFormat = new GeoJSON();
                        const grabflurOlFeatures = geojsonFormat.readFeatures(
                            grabflurGeoJson,
                            {
                                dataProjection: "EPSG:4326",
                                featureProjection: projection,
                            },
                        );

                        // ✅ KORREKTUR: Separate Style-Konstanten definieren
                        const GRABFLUR_STYLE = new Style({
                            stroke: new Stroke({
                                color: "#dc2626", // Rot
                                width: 2,
                            }),
                            fill: new Fill({
                                color: "rgba(234, 88, 12, 0.2)", // 20% Deckkraft
                            }),
                        });

                        const GRABFLUR_HOVER_STYLE = new Style({
                            stroke: new Stroke({
                                color: "#dc2626", // Rot
                                width: 3,
                            }),
                            fill: new Fill({
                                color: "rgba(234, 88, 12, 0.4)", // 40% Deckkraft bei Hover
                            }),
                        });

                        // Erstelle Label-Features für Grabflur-Nummern
                        const labelFeatures = grabflurOlFeatures
                            .map((feature) => {
                                const name = feature.get("name") || "Unbenannt";
                                const number = extractGrabflurNumber(name);
                                const geometry = feature.getGeometry();

                                if (
                                    geometry &&
                                    typeof geometry.getInteriorPoint ===
                                        "function"
                                ) {
                                    const labelFeature = new Feature({
                                        geometry: geometry.getInteriorPoint(),
                                        label: number,
                                    });

                                    labelFeature.setStyle(
                                        new Style({
                                            text: new Text({
                                                text: number,
                                                font: "bold 16px Inter, sans-serif",
                                                fill: new Fill({
                                                    color: "#dc2626",
                                                }),
                                                stroke: new Stroke({
                                                    color: "#ffffff",
                                                    width: 3,
                                                }),
                                                textAlign: "center",
                                                textBaseline: "middle",
                                            }),
                                        }),
                                    );

                                    return labelFeature;
                                }
                                return null;
                            })
                            .filter((f) => f !== null);

                        // Label-Layer erstellen
                        const labelLayer = new VectorLayer({
                            source: new VectorSource({
                                features: labelFeatures,
                            }),
                            zIndex: MAP_CONFIG.Z_INDEX.LABELS, // 30, über allen anderen
                        });

                        // VectorLayer erstellen mit Hover-Interaktion
                        const grabflurLayer = new VectorLayer({
                            source: new VectorSource({
                                features: grabflurOlFeatures,
                            }),
                            style: GRABFLUR_STYLE,
                            zIndex: MAP_CONFIG.Z_INDEX.GRABFLUR, // 20, Über Cemetery-Background
                        });

                        // Hover-Popup erstellen
                        const popupElement = document.createElement("div");
                        popupElement.className = "grabflur-hover-popup";
                        document.body.appendChild(popupElement);

                        const popup = new Overlay({
                            element: popupElement,
                            positioning: "bottom-center",
                            offset: [0, -10],
                            stopEvent: false,
                        });
                        map.addOverlay(popup);

                        // Cleanup bei Fenster-Schließen (Memory Leak Prevention)
                        window.addEventListener("beforeunload", () => {
                            if (hoverTimeout) clearTimeout(hoverTimeout);
                            map.setTarget(undefined); // OpenLayers Cleanup
                        });

                        // ✅ KORREKTUR: Layer-spezifische Hover-Detection mit Popup
                        let hoverFeature = null;
                        let hoverTimeout = null;

                        map.on("pointermove", (evt) => {
                            if (evt.dragging) {
                                return;
                            }

                            // Nur Features vom Grabflur-Layer erkennen
                            let feature = null;
                            map.forEachFeatureAtPixel(evt.pixel, (f, layer) => {
                                if (layer === grabflurLayer) {
                                    feature = f;
                                    return true; // Stop iteration
                                }
                            });

                            // Style-Update nur bei Änderung
                            if (feature !== hoverFeature) {
                                // Clear existing timeout
                                if (hoverTimeout) {
                                    clearTimeout(hoverTimeout);
                                    hoverTimeout = null;
                                }

                                if (hoverFeature) {
                                    hoverFeature.setStyle(GRABFLUR_STYLE);
                                }

                                // Hide popup when leaving feature
                                if (!feature) {
                                    popup.setPosition(undefined);
                                }

                                hoverFeature = feature;

                                if (feature) {
                                    // Apply hover style immediately
                                    feature.setStyle(GRABFLUR_HOVER_STYLE);

                                    // Show popup after 600ms delay
                                    hoverTimeout = setTimeout(() => {
                                        const name =
                                            feature.get("name") || "Unbenannt";
                                        const number =
                                            extractGrabflurNumber(name);

                                        popupElement.innerHTML = `
                                            <div style="font-weight: 600; color: #dc2626; margin-bottom: 4px;">
                                                Grabflur ${number}
                                            </div>
                                            <div style="font-size: 12px; color: #6b7280;">
                                                ${name}
                                            </div>
                                        `;

                                        popup.setPosition(evt.coordinate);
                                    }, 600);
                                }
                            }
                        });

                        // Layer zur Karte hinzufügen
                        map.addLayer(grabflurLayer);
                        map.addLayer(labelLayer);

                        console.log(
                            "Feature-Editor: Grabflur layer added to map with hover interaction",
                        );

                        // Add click interaction for grabflur features on the map
                        map.on("click", async (evt) => {
                            let clickedFeature = null;

                            // Find clicked feature (only from grabflur layer)
                            map.forEachFeatureAtPixel(
                                evt.pixel,
                                (feature, layer) => {
                                    if (layer === grabflurLayer) {
                                        clickedFeature = feature;
                                        return true; // Stop iteration
                                    }
                                },
                            );

                            if (clickedFeature) {
                                const geometry = clickedFeature.getGeometry();
                                if (geometry) {
                                    const extent = geometry.getExtent();

                                    // DEBUGGING: Log map size and extent
                                    console.log(
                                        "=== ZOOM DEBUG (Feature-Editor) ===",
                                    );
                                    const mapSize = map.getSize();
                                    console.log("Map container size:", mapSize);
                                    console.log("Extent to fit:", extent);

                                    // Berechne Extent-Dimensionen
                                    const extentWidth = extent[2] - extent[0];
                                    const extentHeight = extent[3] - extent[1];
                                    console.log(
                                        "Extent size:",
                                        extentWidth,
                                        "x",
                                        extentHeight,
                                        "m",
                                    );

                                    // Berechne Zentrum der Extent
                                    const centerX = (extent[0] + extent[2]) / 2;
                                    const centerY = (extent[1] + extent[3]) / 2;

                                    // Berechne benötigte Resolution für optimale Ausfüllung
                                    // Resolution = Meter pro Pixel
                                    const padding = 40; // 40px Padding
                                    const resolutionX =
                                        extentWidth /
                                        (mapSize[0] - 2 * padding);
                                    const resolutionY =
                                        extentHeight /
                                        (mapSize[1] - 2 * padding);
                                    const targetResolution = Math.max(
                                        resolutionX,
                                        resolutionY,
                                    );

                                    console.log(
                                        "Target resolution:",
                                        targetResolution,
                                        "m/px",
                                    );

                                    // Get actual maxResolution from View
                                    const maxResolution = map
                                        .getView()
                                        .getMaxResolution();
                                    console.log(
                                        "View maxResolution:",
                                        maxResolution,
                                        "m/px",
                                    );

                                    const calculatedZoom = Math.log2(
                                        maxResolution / targetResolution,
                                    );

                                    // Begrenze Zoom auf vernünftige Werte
                                    const minZoom = 16;
                                    const maxZoom = 21;
                                    const targetZoom = Math.min(
                                        maxZoom,
                                        Math.max(minZoom, calculatedZoom),
                                    );

                                    console.log(
                                        "Calculated zoom:",
                                        calculatedZoom,
                                    );
                                    console.log(
                                        "Target zoom (clamped):",
                                        targetZoom,
                                    );

                                    // Mark as programmatic zoom
                                    (map as any).isProgrammaticZoom = true;

                                    // Zoom mit Animation
                                    map.getView().animate({
                                        center: [centerX, centerY],
                                        zoom: targetZoom,
                                        duration: 300,
                                        callback: () => {
                                            // Reset flag after animation
                                            (map as any).isProgrammaticZoom =
                                                false;
                                        },
                                    });

                                    // Log final zoom after animation
                                    setTimeout(() => {
                                        console.log(
                                            "Final zoom level:",
                                            map.getView().getZoom(),
                                        );
                                    }, 350);

                                    // Reset previous hover feature
                                    if (hoverFeature) {
                                        hoverFeature.setStyle(GRABFLUR_STYLE);
                                    }

                                    // Apply hover style to clicked feature
                                    clickedFeature.setStyle(
                                        GRABFLUR_HOVER_STYLE,
                                    );
                                    hoverFeature = clickedFeature;

                                    // Save view state after zoom for back navigation
                                    setTimeout(() => {
                                        const viewHistory =
                                            getViewHistoryManager(map);
                                        if (viewHistory) {
                                            viewHistory.pushState();
                                            updateNavButtons(map);
                                        }
                                    }, 400); // After zoom animation
                                }
                            }
                        });

                        // Set names for hover popup display
                        grabflurOlFeatures.forEach((olFeature, index) => {
                            const properties =
                                grabflurFeatures[index]?.properties || {};
                            const featureName =
                                properties.name || `Grabflur ${index + 1}`;
                            olFeature.set("name", featureName);
                        });

                        // Update feature count display
                        const featureCount =
                            document.getElementById("feature-count");
                        if (featureCount) {
                            featureCount.textContent = `${grabflurFeatures.length} Grabfluren`;
                        }
                    } else {
                        console.warn("No grabflur features found");
                        const featureCount =
                            document.getElementById("feature-count");
                        if (featureCount) {
                            featureCount.textContent =
                                "Keine Grabfluren gefunden";
                        }
                    }
                } catch (error) {
                    console.error("Error loading grabflur features:", error);
                    const featureCount =
                        document.getElementById("feature-count");
                    if (featureCount) {
                        featureCount.textContent =
                            "Fehler beim Laden der Grabfluren";
                    }
                }
            }

            /**
             * Extract grabflur number from feature name
             */
            function extractGrabflurNumber(name) {
                if (!name) return null;
                // Look for patterns like "Rheinkassel-007" → "007"
                const match = name.match(/-(\d+)$/);
                return match ? match[1] : name;
            }

            /**
             * Update sidebar highlight for selected feature
             */
            function updateSidebarHighlight(selectedFeature) {
                // Remove previous highlights
                document
                    .querySelectorAll(".grabflur-item.highlighted")
                    .forEach((item) => {
                        item.classList.remove("highlighted");
                    });

                // Add highlight to selected feature
                if (selectedFeature) {
                    const featureName = selectedFeature.get("name");
                    const grabflurNumber = extractGrabflurNumber(featureName);
                    const selector = grabflurNumber
                        ? `[data-grabflur="${grabflurNumber}"]`
                        : `[data-feature="${featureName}"]`;

                    const item = document.querySelector(selector);
                    if (item) {
                        item.classList.add("highlighted");
                        item.scrollIntoView({
                            behavior: "smooth",
                            block: "nearest",
                        });
                    }
                }
            }

            /**
             * Update navigation button states based on history
             */
            function updateNavButtons(map) {
                const backBtn = document.getElementById("nav-back");
                const fwdBtn = document.getElementById("nav-forward");

                if (!backBtn || !fwdBtn) return;

                const viewHistory = getViewHistoryManager(map);
                if (!viewHistory) return;

                const state = viewHistory.getState();
                backBtn.disabled = !state.canGoBack;
                fwdBtn.disabled = !state.canGoForward;
            }
        })();
    </script>
</BaseLayout>
