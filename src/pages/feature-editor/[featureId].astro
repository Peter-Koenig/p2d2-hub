---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "../../styles/feature-popup.css";
import "../../styles/feature-editor.css";
import FeatureEditorHeader from "../../components/feature-editor/FeatureEditorHeader.astro";
import NavigationControls from "../../components/feature-editor/NavigationControls.astro";
import LayerControls from "../../components/feature-editor/LayerControls.astro";
import Toolbar from "../../components/feature-editor/Toolbar.astro"; // NEU

import { initializeCrossWindowBridge } from "../../utils/cross-window-events";
initializeCrossWindowBridge();
console.log("[feature-editor] Cross-window bridge initialized (editor window)");

const { featureId } = Astro.params;
const wpName = Astro.url.searchParams.get("wp_name") ?? "";
const containerType = Astro.url.searchParams.get("container_type") ?? "";
const name = Astro.url.searchParams.get("name") ?? "";
const extent = Astro.url.searchParams.get("extent") ?? ""; // WGS84 Extent
const projection = Astro.url.searchParams.get("projection") ?? ""; // Lokale Projektion (z.B. EPSG:25832)

// Validate required parameters
if (!wpName || !containerType || !name || !extent || !projection) {
    throw new Error(
        "Missing required URL parameters (wp_name, container_type, name, extent, projection)",
    );
}

// Decode feature name for display
const decodedName = decodeURIComponent(name);

// Die Logik zur Ermittlung der Projektion aus der Collection [cite: 1030-1031]
// ist gut, aber der `projection` Parameter aus der URL ist zuverlässiger,
// da er direkt vom Client (map-state [cite: 100]) gesetzt wird. Wir vertrauen dem Parameter.
---

<BaseLayout title={`Feature Editor: ${decodedName}`} showFooter={false}>
    <!-- WICHTIG: slot="header" überschreibt den Standard-Header -->
    <FeatureEditorHeader slot="header" friedhofName={decodedName} />

    <div class="feature-editor-container">
        <div class="editor-content">
            <div class="map-container">
                <div
                    id="feature-editor-map"
                    class="w-full h-full"
                    data-wp-name={wpName}
                    data-container-type={containerType}
                    data-name={name}
                    data-extent={extent}
                    data-projection={projection}
                >
                </div>

                <NavigationControls />
                <LayerControls />
                <Toolbar />
            </div>
        </div>
    </div>

    <script>
        import EditorApp from "../../components/feature-editor/EditorApp";
        import { initializeCrossWindowBridge } from "../../utils/cross-window-events";

        /**
         * Robuste DOM-Ready-Funktion
         * Funktioniert auch wenn DOMContentLoaded schon gefeuert hat
         */
        function domReady(callback: () => void): void {
            if (document.readyState === "loading") {
                // DOM lädt noch - warte auf Event
                document.addEventListener("DOMContentLoaded", callback, {
                    once: true,
                });
            } else {
                // DOM ist schon fertig - sofort ausführen
                callback();
            }
        }

        // Editor initialisieren
        domReady(() => {
            if (typeof window === "undefined") return;

            // Cross-Window-Bridge initialisieren
            initializeCrossWindowBridge();
            console.log(
                "[feature-editor] Cross-window bridge initialized (editor window)",
            );

            // Editor-Container finden
            const container = document.getElementById("feature-editor-map");
            if (!container) {
                console.error(
                    "Editor-Map-Container nicht gefunden. App kann nicht starten.",
                );
                return;
            }

            // EditorApp initialisieren
            try {
                const editorApp = new EditorApp(container);

                // Globalen Zugriff für Layer-Controls und Debugging
                (window as any).editorApp = editorApp;

                editorApp
                    .init()
                    .then(() => {
                        // LayerManager global verfügbar machen
                        if (editorApp["layerManager"]) {
                            (window as any).layerManager =
                                editorApp["layerManager"];
                        }
                        console.log("✅ Editor erfolgreich initialisiert");
                    })
                    .catch((error: Error) => {
                        console.error(
                            "Fehler beim Initialisieren des Editors:",
                            error,
                        );
                    });
            } catch (error) {
                console.error(
                    "Fehler beim Erstellen der EditorApp-Instanz:",
                    error,
                );
            }
        });
    </script>
</BaseLayout>
