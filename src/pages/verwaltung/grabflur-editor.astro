---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUserSession } from '../../lib/auth/session';
import { getKommuneBySlug } from '../../utils/kommune-utils';
import '../../styles/feature-editor.css';

const session = getUserSession(Astro.locals);

if (!session.isAuthenticated || !session.roles.includes('verwaltung')) {
  return Astro.redirect('/');
}

const kommuneMembership = session.memberships?.find((m) => m.type === 'kommune');
const kommuneSlug =
  kommuneMembership?.key ?? session.preferences?.homeKommuneSlug ?? null;
const kommune = kommuneSlug ? await getKommuneBySlug(kommuneSlug) : null;

const wpName     = kommune?.wpName ?? '';
const extent     = kommune?.map?.extent ?? null;
const center     = kommune?.map?.center ?? null;
const projection = kommune?.map?.projection ?? 'EPSG:3857';
const zoom       = kommune?.map?.zoom ?? 12;
const kommuneTitle = kommune?.title ?? 'unbekannte Kommune';
---

<BaseLayout title={`Grabflur-Editor – ${kommuneTitle} | p2d2`} showFooter={false}>

  <!-- Editor-Header via slot -->
  <header slot="header" class="feature-editor-header">
    <div class="logo-container">
      <img src="/images/logo.svg" alt="p2d2 Logo" class="logo" />
      <span class="brand-name">p2d2</span>
    </div>
    <h1 class="editor-title">Grabflur-Editor: {kommuneTitle}</h1>
    <button id="close-editor-btn" class="close-btn" aria-label="Editor schließen">
      Schließen
    </button>
  </header>

  <!-- Layout: nutzt feature-editor.css-Klassen für korrekte Darstellung mit abgerundeten Ecken -->
  <div class="feature-editor-container">
    <div class="editor-content">
      {kommune ? (
        <div class="map-container">
          <div
            id="grabflur-map"
            class="w-full h-full"
            data-wp-name={wpName}
            data-extent={extent ? JSON.stringify(extent) : ''}
            data-center={center ? JSON.stringify(center) : ''}
            data-projection={projection}
            data-zoom={zoom}
          ></div>
          <!-- Navigation-Vor/Zurück -->
          <div class="nav-controls">
            <button id="nav-back" class="nav-btn" title="Zurück (Alt+←)" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            <button id="nav-forward" class="nav-btn" title="Vor (Alt+→)" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      ) : (
        <div class="flex-1 flex items-center justify-center">
          <div class="text-center max-w-md mx-auto p-8">
            <h2 class="font-poppins font-bold text-2xl text-gray-900 mb-4">
              Keine Kommune gefunden
            </h2>
            <p class="text-gray-700 mb-6">
              Aus Ihren Benutzer-Metadaten konnte keine zugeordnete Kommune
              abgeleitet werden. Bitte wenden Sie sich an Ihren Administrator.
            </p>
            <a
              href="/verwaltung"
              class="inline-block px-4 py-2 rounded-md text-sm font-medium text-white bg-green-700 hover:bg-green-800 transition-colors"
            >
              Zurück zur Verwaltung
            </a>
          </div>
        </div>
      )}
    </div>
  </div>

  <style>
    .feature-editor-header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(240, 253, 244, 0.9);
      border-bottom: 1px solid #bbf7d0;
      gap: 1rem;
      position: relative;
      z-index: 50;
    }
    .logo-container { display: flex; align-items: center; gap: 0.75rem; }
    .logo           { height: 2rem; width: auto; }
    .brand-name     { font-size: 1.5rem; font-weight: 700; color: #14532d; }
    .editor-title   {
      font-size: 1.25rem; font-weight: 600; color: #14532d;
      text-align: center; margin: 0;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .close-btn {
      padding: 0.5rem 1rem; background: #dc2626; color: white;
      border: none; border-radius: 0.375rem; font-weight: 500;
      cursor: pointer; transition: background 0.2s; font-size: 0.875rem;
      white-space: nowrap;
    }
    .close-btn:hover  { background: #b91c1c; }
    .close-btn:active { transform: scale(0.98); }

    @media (max-width: 768px) {
      .feature-editor-header {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto;
        padding: 0.75rem 1rem;
        gap: 0.5rem;
      }
      .logo-container { grid-column: 1; grid-row: 1; }
      .close-btn      { grid-column: 1; grid-row: 1; justify-self: end; align-self: center; padding: 0.375rem 0.75rem; }
      .editor-title   { grid-column: 1; grid-row: 2; font-size: 1rem; }
      .logo           { height: 1.5rem; }
      .brand-name     { font-size: 1.25rem; }
    }
    /* Navigations-Buttons (vor/zurück) */
    .nav-controls {
      position: absolute;
      top: 0.5rem;
      left: 2.5rem;
      display: flex;
      gap: 0.5rem;
      z-index: 40;
    }
    .nav-btn {
      width: 20px;
      height: 20px;
      background: white;
      border: none;
      border-radius: 0.25rem;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .nav-btn:hover:not(:disabled) {
      background: #dc2626;
      color: white;
      transform: scale(1.05);
    }
    .nav-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
    .nav-btn svg {
      width: 10px;
      height: 10px;
    }
    @media (max-width: 768px) {
      .nav-controls { top: 0.75rem; left: 0.75rem; }
      .nav-btn { width: 18px; height: 18px; }
      .nav-btn svg { width: 9px; height: 9px; }
    }
    @media (prefers-contrast: high) {
      .nav-btn { border: 1px solid #374151; }
    }
    @media (prefers-reduced-motion: reduce) {
      .nav-btn { transition: none; }
      .nav-btn:hover:not(:disabled) { transform: none; }
    }
  </style>

  <script>
    document.getElementById('close-editor-btn')?.addEventListener('click', () => {
      window.close();
      if (!window.closed) window.history.back();
    });
  </script>

  <script>
    import { MapManager } from '../../components/feature-editor/MapManager';
    import { wfsAuthClient } from '../../utils/wfs-auth';
    import { initializeCrossWindowBridge } from '../../utils/cross-window-events';
    import GeoJSON from 'ol/format/GeoJSON';
    import VectorSource from 'ol/source/Vector';
    import VectorLayer from 'ol/layer/Vector';
    import Overlay from 'ol/Overlay';
    import { Style, Stroke, Fill } from 'ol/style';
    import { Select } from 'ol/interaction';
    import { click } from 'ol/events/condition';
    import { getArea } from 'ol/sphere';
    import { transformExtent } from 'ol/proj';

    function domReady(callback: () => void): void {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', callback, { once: true });
      } else {
        callback();
      }
    }

    domReady(async () => {
      // Cross-Window-Bridge initialisieren (für EventConsole Cross-Window-Logging)
      initializeCrossWindowBridge();

      const container = document.getElementById('grabflur-map');
      if (!container) return;

      const wpName     = container.dataset.wpName || '';
      const projection = container.dataset.projection || 'EPSG:3857';
      const extentRaw  = container.dataset.extent || '';
      const centerRaw  = container.dataset.center || '';
      const zoom       = parseInt(container.dataset.zoom || '12', 10);

      try {
        // 1. MapManager initialisieren
        const mapManager = new MapManager('grabflur-map', projection);
        const map = mapManager.getMap();

        // ViewHistory für Vor/Zurück-Navigation
        const viewHistory = mapManager.getViewHistory();

        // Navigations-Buttons verdrahten
        const backBtn = document.getElementById('nav-back') as HTMLButtonElement;
        const fwdBtn  = document.getElementById('nav-forward') as HTMLButtonElement;

        backBtn?.addEventListener('click', () => viewHistory.back());
        fwdBtn?.addEventListener('click', () => viewHistory.forward());

        // Button-Status via subscribe
        viewHistory.subscribe((state) => {
          if (backBtn) backBtn.disabled = !state.canGoBack;
          if (fwdBtn)  fwdBtn.disabled  = !state.canGoForward;
        });

        // Initialen Button-Status setzen
        const initState = viewHistory.getState();
        if (backBtn) backBtn.disabled = !initState.canGoBack;
        if (fwdBtn)  fwdBtn.disabled  = !initState.canGoForward;

        // Keyboard-Shortcuts: Alt+← / Alt+→
        document.addEventListener('keydown', (e) => {
          if (e.altKey && e.key === 'ArrowLeft')  { e.preventDefault(); viewHistory.back(); }
          if (e.altKey && e.key === 'ArrowRight') { e.preventDefault(); viewHistory.forward(); }
        });

        // 2. Friedhofs-WFS-Layer vorbereiten (Layer vor postrender hinzufügen)
        const friedhofSource = new VectorSource();
        const friedhofLayer = new VectorLayer({
          source: friedhofSource,
          zIndex: 20,
          style: new Style({
            stroke: new Stroke({ color: '#FF6900', width: 2 }),
            fill:   new Fill({ color: 'rgba(255, 105, 0, 0.1)' }),
          }),
        });
        map.addLayer(friedhofLayer);

        // 2b. Grabflur-WFS-Layer (zunächst unsichtbar, wird bei Klick auf Friedhof geladen)
        const grabflureSource = new VectorSource();
        const grabflureLayer = new VectorLayer({
          source: grabflureSource,
          zIndex: 21,
          visible: false,
          style: new Style({
            stroke: new Stroke({ color: '#FF6900', width: 1.5 }),
            fill:   new Fill({ color: 'rgba(255, 105, 0, 0.08)' }),
          }),
        });
        map.addLayer(grabflureLayer);

        // Hover-Popup vorbereiten
        const popupElement = document.createElement('div');
        popupElement.className = 'grabflur-hover-popup';
        popupElement.style.cssText =
          'display:none;position:absolute;background:white;border:1px solid #FF6900;border-radius:6px;padding:6px 10px;font-size:13px;pointer-events:none;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.15);';
        document.body.appendChild(popupElement);

        const hoverPopup = new Overlay({
          element: popupElement,
          positioning: 'bottom-center',
          offset: [0, -10],
          stopEvent: false,
        });
        map.addOverlay(hoverPopup);

        // 3. FIX Race Condition: WFS-Load NACH erstem postrender
        //    → Map hat dann garantiert eine echte Größe (nicht [0,0])
        map.once('postrender', async () => {
          map.updateSize();

          // 4. WFS-Daten laden
          if (!wpName) return;

          try {
            const baseUrl = wfsAuthClient.buildWFSURL('geo-containers');
            const cqlFilter = `container_type='cemetery' AND osm_admin_level=8 AND wp_name='${wpName}'`;
            const wfsUrl = `${baseUrl}&CQL_FILTER=${encodeURIComponent(cqlFilter)}`;

            const response = await wfsAuthClient.fetchWFS(wfsUrl);
            if (!response.ok) throw new Error(`WFS ${response.status} ${response.statusText}`);

            const geojson  = await response.json();
            const format   = new GeoJSON();
            const features = format.readFeatures(geojson, {
              dataProjection: 'EPSG:4326',
              featureProjection: projection,
            });

            if (geojson.features) {
              geojson.features.forEach((raw: any, i: number) => {
                if (features[i]) {
                  features[i].set('name', raw.properties?.name || 'Unbenannt');
                  features[i].set('container_type', raw.properties?.container_type || '');
                }
              });
            }



            friedhofSource.addFeatures(features);

            // ─── DIAGNOSE 1: Feature-Validierung ───
            /* DIAG */ console.log('--- DIAGNOSE [Grabflur-Editor] ---');
            /* DIAG */ console.log('[DIAG] Features im Source:', friedhofSource.getFeatures().length);
            /* DIAG */ const firstFeat = features[0];
            /* DIAG */ if (firstFeat) {
            /* DIAG */   const geom = firstFeat.getGeometry();
            /* DIAG */   const coords = geom ? (geom as any).getFirstCoordinate() : undefined;
            /* DIAG */   console.log('[DIAG] Erstes Feature – Typ:', geom?.getType(), '| erste Koordinate:', coords);
            /* DIAG */   console.log('[DIAG]   → Erwarte UTM-Werte (z.B. [354000, 5645000]) – sind es lat/lon?');
            /* DIAG */ }
            /* DIAG */ const srcExtent = friedhofSource.getExtent();
            /* DIAG */ console.log('[DIAG] Source-Extent:', srcExtent);
            /* DIAG */ console.log('[DIAG] Extent ist valide (nicht Infinity)?', srcExtent.every((v: number) => Number.isFinite(v)));
            /* DIAG */ console.log('[DIAG] View-Projektion:', map.getView().getProjection().getCode());
            /* DIAG */ console.log('[DIAG] featureProjection beim readFeatures:', projection);
            /* DIAG */ console.log('--- ENDE DIAGNOSE 1 ---');

            // Auf geladene Features zoomen
            if (features.length > 0) {
              const loadedExtent = friedhofSource.getExtent();
              const mapSize      = map.getSize();
              console.log('[Grabflur-Editor] 🔍 fit() Aufruf:', { loadedExtent, mapSize });
              if (mapSize && mapSize[0] > 0 && loadedExtent.every(Number.isFinite)) {
                map.getView().fit(loadedExtent, {
                  size:    mapSize,
                  padding: [50, 50, 50, 50],
                  maxZoom: 16,
                });
                viewHistory.pushState(); // Initialen Übersichts-Zoom speichern
                console.log('[Grabflur-Editor] ✅ fit() ausgeführt, Center:', map.getView().getCenter());
              }
            }

            console.log(`[Grabflur-Editor] ✅ ${features.length} Friedhöfe geladen`);

            // ─── DIAGNOSE 2: Render-Check nach dem durch fit() getriggerten Render ───
            /* DIAG */ map.once('postrender', () => {
            /* DIAG */   console.log('--- DIAGNOSE 2 [Grabflur-Editor] nach fit()-Render ---');
            /* DIAG */   const centerCoord = map.getView().getCenter();
            /* DIAG */   const centerPixel = centerCoord ? map.getPixelFromCoordinate(centerCoord) : null;
            /* DIAG */   console.log('[DIAG2] View-Center (Koordinate):', centerCoord);
            /* DIAG */   console.log('[DIAG2] View-Center (Pixel):', centerPixel);
            /* DIAG */   console.log('[DIAG2] Map-Size:', map.getSize());
            /* DIAG */   console.log('[DIAG2] View-Zoom:', map.getView().getZoom());
            /* DIAG */   console.log('[DIAG2] Layer sichtbar?:', friedhofLayer.getVisible());
            /* DIAG */   console.log('[DIAG2] Layer-ZIndex:', friedhofLayer.getZIndex());
            /* DIAG */   console.log('[DIAG2] Feature-Anzahl Source:', friedhofSource.getFeatures().length);
            /* DIAG */   console.log('[DIAG2] Layer-Liste:',
            /* DIAG */     map.getLayers().getArray().map((l: any, i: number) =>
            /* DIAG */       `${i}:${l instanceof VectorLayer ? 'Vector' : 'Tile'} z=${l.getZIndex()}`
            /* DIAG */     ).join(' | ')
            /* DIAG */   );
            /* DIAG */   // Prüfe Features an 9 gleichmäßig verteilten Pixeln (3×3 Raster)
            /* DIAG */   if (centerPixel) {
            /* DIAG */     const mapSize = map.getSize()!;
            /* DIAG */     const pixelsToCheck = [
            /* DIAG */       { label: 'Zentrum', px: centerPixel[0], py: centerPixel[1] },
            /* DIAG */       { label: 'oben-links', px: 50, py: 50 },
            /* DIAG */       { label: 'oben-rechts', px: mapSize[0] - 50, py: 50 },
            /* DIAG */       { label: 'unten-links', px: 50, py: mapSize[1] - 50 },
            /* DIAG */       { label: 'unten-rechts', px: mapSize[0] - 50, py: mapSize[1] - 50 },
            /* DIAG */       { label: 'oben-Mitte', px: Math.round(mapSize[0] / 2), py: 50 },
            /* DIAG */       { label: 'unten-Mitte', px: Math.round(mapSize[0] / 2), py: mapSize[1] - 50 },
            /* DIAG */       { label: 'Mitte-links', px: 50, py: Math.round(mapSize[1] / 2) },
            /* DIAG */       { label: 'Mitte-rechts', px: mapSize[0] - 50, py: Math.round(mapSize[1] / 2) },
            /* DIAG */     ];
            /* DIAG */     let totalFound = 0;
            /* DIAG */     for (const p of pixelsToCheck) {
            /* DIAG */       const features = map.getFeaturesAtPixel([p.px, p.py], { hitTolerance: 5 });
            /* DIAG */       if (features && features.length > 0) {
            /* DIAG */         totalFound += features.length;
            /* DIAG */         console.log('[DIAG2] ✅ Pixel', p.label, `(${p.px},${p.py}):`, features.length, 'Feature(s)');
            /* DIAG */         features.forEach((f: any) => console.log('[DIAG2]   →', f.get('name') || 'unbenannt'));
            /* DIAG */       } else {
            /* DIAG */         console.log('[DIAG2] ❌ Pixel', p.label, `(${p.px},${p.py}):`, '0 Features');
            /* DIAG */       }
            /* DIAG */     }
            /* DIAG */     console.log('[DIAG2] Features insgesamt an 9 Pixeln:', totalFound);
            /* DIAG */     if (totalFound === 0) {
            /* DIAG */       console.log('[DIAG2] 🚨 KEIN EINZIGES Feature an 9 Pixeln gefunden – Layer wird NICHT gerendert!');
            /* DIAG */       console.log('[DIAG2] Mögliche Ursachen: Layer unsichtbar, WebGL-Fehler, Z-Index-Konflikt, Canvas nicht im DOM');
            /* DIAG */     }
            /* DIAG */   }
            /* DIAG */   console.log('--- ENDE DIAGNOSE 2 ---');
            /* DIAG */ });
            // ─── ENDE DIAGNOSE 2 ───

          } catch (err) {
            console.error('[Grabflur-Editor] WFS-Fehler:', err);
            const mapEl = document.getElementById('grabflur-map');
            if (mapEl) {
              const errDiv = document.createElement('div');
              errDiv.className = 'absolute inset-0 flex items-center justify-center bg-white/80 z-50';
              errDiv.innerHTML = `<p class="text-red-600 font-medium">Fehler beim Laden der Friedhöfe:<br>
                <span class="text-sm font-normal">${err instanceof Error ? err.message : 'Unbekannter Fehler'}</span></p>`;
              mapEl.style.position = 'relative';
              mapEl.appendChild(errDiv);
            }
          }
        }); // Ende map.once('postrender')

        // 5. Hover-Interaktion
        let hoverFeature: any = null;
        let hoverFeatureType = '';
        let hoverTimeout: ReturnType<typeof setTimeout> | null = null;
        const HOVER_STYLE = new Style({
          stroke: new Stroke({ color: '#CC5500', width: 3 }),
          fill:   new Fill({ color: 'rgba(255, 105, 0, 0.35)' }),
        });

        map.on('pointermove', (evt) => {
          if (evt.dragging) return;
          let featureAtPixel: any = null;
          let featureLayer = '';
          map.forEachFeatureAtPixel(evt.pixel, (f, layer) => {
            if (layer === grabflureLayer) { featureAtPixel = f; featureLayer = 'grabflure'; return true; }
            if (layer === friedhofLayer)  { featureAtPixel = f; featureLayer = 'friedhof';  return true; }
            return false;
          });

          if (featureAtPixel !== hoverFeature) {
            if (hoverTimeout) clearTimeout(hoverTimeout);
            if (hoverFeature) hoverFeature.setStyle(undefined);
            hoverFeature = featureAtPixel;
            hoverFeatureType = featureLayer;

            if (!featureAtPixel) {
              popupElement.style.display = 'none';
              hoverPopup.setPosition(undefined);
              return;
            }

            featureAtPixel.setStyle(HOVER_STYLE);
            hoverTimeout = setTimeout(() => {
              const name = featureAtPixel.get('name') || 'Unbenannt';
              const label = hoverFeatureType === 'grabflure' ? 'Grabflur' : 'Friedhof';
              popupElement.innerHTML = `
                <div style="font-weight:600;color:#FF6900;">${label}</div>
                <div style="color:#374151;font-size:12px;">${name}</div>`;
              popupElement.style.display = 'block';
              hoverPopup.setPosition(evt.coordinate);
            }, 600);
          }
        });

        // 6. Klick-Selektion + Zoom + Grabflur-Ladung
        const select = new Select({
          condition: click,
          style: new Style({
            stroke: new Stroke({ color: '#CC5500', width: 3 }),
            fill:   new Fill({ color: 'rgba(255, 105, 0, 0.25)' }),
          }),
        });
        map.addInteraction(select);

        // Aktuell geladener Cemetery (für Grabflur-Race-Condition)
        let currentCemeteryId: string | null = null;

        select.on('select', async (e) => {
          const selected = e.selected[0];

          // ── Deselektiert → Grabflure ausblenden ──
          if (!selected) {
            grabflureSource.clear();
            grabflureLayer.setVisible(false);
            currentCemeteryId = null;
            console.log('[Grabflur-Editor] Grabflure ausgeblendet');
            return;
          }

          const name = selected.get('name') || 'Unbenannt';
          const cemeteryId = selected.getId() || name;
          currentCemeteryId = cemeteryId;
          console.log(`[Grabflur-Editor] Zoom auf Friedhof: ${name}`);

          const geom = selected.getGeometry();
          if (!geom) return;

          const extent = geom.getExtent();
          const mapSize = map.getSize();
          if (mapSize && extent && extent.every(Number.isFinite)) {
            viewHistory.pushState(); // Aktuelle Position vor Zoom speichern
            map.getView().fit(extent, {
              size:    mapSize,
              padding: [100, 100, 100, 100],
              maxZoom: 19,
              duration: 500,
            });
          }

          // ── Grabflure für diesen Friedhof laden ──
          try {
            // Cemetery-Extent von UTM nach WGS84 transformieren (für WFS-Filter)
            const extentWGS84 = transformExtent(extent, projection, 'EPSG:4326');
            const bboxFilter = `${extentWGS84[0]},${extentWGS84[1]},${extentWGS84[2]},${extentWGS84[3]},EPSG:4326`;

            const grabflureUrl = wfsAuthClient.buildWFSURL('grabflure', {
              bbox: bboxFilter,
            });

            const response = await wfsAuthClient.fetchWFS(grabflureUrl);
            if (!response.ok) throw new Error(`WFS ${response.status}`);

            const geojson = await response.json();
            const format = new GeoJSON();
            const grabflureFeatures = format.readFeatures(geojson, {
              dataProjection: 'EPSG:4326',
              featureProjection: projection,
            });

            // Attribute aus GeoJSON-Properties übernehmen
            if (geojson.features) {
              geojson.features.forEach((raw: any, i: number) => {
                if (grabflureFeatures[i]) {
                  const p = raw.properties || {};
                  grabflureFeatures[i].set('p2d2_uuid', p.p2d2_uuid || '');
                  grabflureFeatures[i].set('fh_nr', p.fh_nr || '');
                  grabflureFeatures[i].set('fh_name', p.fh_name || '');
                  grabflureFeatures[i].set('flur_nr', p.flur_nr || '');
                  grabflureFeatures[i].set('wp_name', p.wp_name || '');
                  grabflureFeatures[i].set('workflow_status', p.workflow_status || '');
                  // Anzeigename für Hover-Popup
                  const label = p.flur_nr ? `Flur ${p.flur_nr}` : (p.fh_name || 'Unbenannt');
                  grabflureFeatures[i].set('name', label);
                }
              });
            }

            // Nur anwenden, wenn seit dem Request kein anderer Cemetery geklickt wurde
            if (currentCemeteryId !== cemeteryId) {
              console.log('[Grabflur-Editor] ⏭️ Grabflure veraltet (anderer Cemetery gewählt)');
              return;
            }

            grabflureSource.clear();
            if (grabflureFeatures.length > 0) {
              grabflureSource.addFeatures(grabflureFeatures);
              grabflureLayer.setVisible(true);
              const sample = grabflureFeatures[0].get('flur_nr') || grabflureFeatures[0].get('fh_name') || '';
              console.log(`[Grabflur-Editor] 🗺️ ${grabflureFeatures.length} Grabflure geladen für "${name}" (z.B. Flur ${sample})`);
            } else {
              grabflureLayer.setVisible(false);
              console.log(`[Grabflur-Editor] 🗺️ Keine Grabflure gefunden für "${name}"`);
            }
          } catch (err) {
            console.error('[Grabflur-Editor] Grabflur-Fehler:', err);
            grabflureLayer.setVisible(false);
          }
        });

      } catch (err) {
        console.error('[Grabflur-Editor] Initialisierungsfehler:', err);
        const mapEl = document.getElementById('grabflur-map');
        if (mapEl) {
          const errDiv = document.createElement('div');
          errDiv.className = 'absolute inset-0 flex items-center justify-center bg-white/80';
          errDiv.innerHTML = '<p class="text-red-600 font-medium">Fehler beim Initialisieren der Karte.</p>';
          mapEl.style.position = 'relative';
          mapEl.appendChild(errDiv);
        }
      }
    });
  </script>

</BaseLayout>
