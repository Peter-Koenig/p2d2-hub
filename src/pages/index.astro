---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import Footer from "../components/Footer.astro";
// Weitere Komponenten kannst du hier importieren, wenn sie bereit sind
// import MissionStatement from '../components/MissionStatement.astro';
// import CommunitySection from '../components/CommunitySection.astro';
// import ThemenbereicheOverview from '../components/ThemenbereicheOverview.astro';
import OpenLayersMap from "../components/OpenLayersMap.astro";
import KategorienGrid from "../components/KategorienGrid.astro";
import KommunenGrid from "../components/KommunenGrid.astro";
import WerteGrid from "../components/WerteGrid.astro";
import { getAllKategorien } from "../utils/kategorie-utils";
// import { dispatchSelectCategory } from "../utils/events.js";

// Lade Kategorien für data-category-map
const kategorien = await getAllKategorien();

import { initializeCrossWindowBridge } from "../utils/cross-window-events";

// Erstelle Mapping: slug -> containerType
const categoryMap: Record<string, { containerType?: string }> = {};
for (const kategorie of kategorien) {
    categoryMap[kategorie.slug] = { containerType: kategorie.containerType };
}
---

<BaseLayout title="P2D2">
    <!-- Verstecktes Element mit data-category-map -->
    <div
        id="category-data"
        data-category-map={JSON.stringify(categoryMap)}
        style="display: none;"
        aria-hidden="true"
    >
    </div>

    <HeroSection />
    <OpenLayersMap />

    <!-- Grid-Container mit Swipe-Unterstützung -->
    <div id="grid-container" class="relative overflow-hidden">
        <div id="kommunen-grid" class="transition-opacity duration-300">
            <KommunenGrid />
        </div>
        <div
            id="kategorien-grid"
            class="transition-opacity duration-300 opacity-0 absolute inset-0"
            style="pointer-events: none;"
        >
            <KategorienGrid />
        </div>
    </div>

    <WerteGrid />

    <!-- Beispiel: Hier kannst du weitere Inhalts-Komponenten einfügen, sobald sie bereit sind -->
    {
        /*
  <MissionStatement />
  <CommunitySection />
  <ThemenbereicheOverview />
  */
    }

    <script>
        import {
            getPersistedTab,
            setPersistedTab,
        } from "../utils/tab-persistence";
        import { EventConsole } from "../components/EventConsole";
        import { initializeCrossWindowBridge } from "../utils/cross-window-events";

        // Tab-Umschaltung
        const tabButtons = document.querySelectorAll(".tab-button");
        const kommunenGrid = document.getElementById("kommunen-grid");
        const kategorienGrid = document.getElementById("kategorien-grid");
        const gridContainer = document.getElementById("grid-container");

        // Current tab state
        let currentTab = "kommunen";

        // Prevent multiple tab initialization
        let tabsInitialized = false;

        function switchTab(tabName: "kommunen" | "kategorien") {
            // Update internal state
            currentTab = tabName;

            // Persist tab selection using precise storage key
            setPersistedTab(tabName);

            tabButtons.forEach((btn: Element) => {
                const isActive = (btn as HTMLElement).dataset.tab === tabName;
                btn.classList.toggle("active", isActive);

                // Spezifische Farben für die Buttons
                if ((btn as HTMLElement).dataset.tab === "kommunen") {
                    btn.className = isActive
                        ? "tab-button active bg-orange-500 text-white font-semibold px-6 py-3 rounded-lg shadow-lg backdrop-blur-sm transition-all duration-200 border-t-4 border-orange-400"
                        : "tab-button bg-orange-400/80 hover:bg-orange-500 text-white font-semibold px-6 py-3 rounded-lg shadow-lg backdrop-blur-sm transition-all duration-200 border-t-4 border-orange-300";
                } else if ((btn as HTMLElement).dataset.tab === "kategorien") {
                    btn.className = isActive
                        ? "tab-button active bg-green-500 text-white font-semibold px-6 py-3 rounded-lg shadow-lg backdrop-blur-sm transition-all duration-200 border-t-4 border-green-400"
                        : "tab-button bg-green-400/80 hover:bg-green-500 text-white font-semibold px-6 py-3 rounded-lg shadow-lg backdrop-blur-sm transition-all duration-200 border-t-4 border-green-300";
                }
            });

            if (tabName === "kommunen") {
                if (kommunenGrid && kategorienGrid) {
                    kommunenGrid.classList.remove("opacity-0", "absolute");
                    kommunenGrid.style.pointerEvents = "auto";
                    kategorienGrid.classList.add("opacity-0", "absolute");
                    kategorienGrid.style.pointerEvents = "none";
                }
            } else {
                if (kommunenGrid && kategorienGrid) {
                    kommunenGrid.classList.add("opacity-0", "absolute");
                    kommunenGrid.style.pointerEvents = "none";
                    kategorienGrid.classList.remove("opacity-0", "absolute");
                    kategorienGrid.style.pointerEvents = "auto";
                }
            }
        }
        (window as any).switchTab = switchTab;

        tabButtons.forEach((btn: Element) => {
            // Remove existing listeners to prevent duplicates
            const existingHandler = (btn as HTMLButtonElement).dataset
                .clickHandler;
            if (existingHandler) {
                btn.removeEventListener(
                    "click",
                    (window as any)[existingHandler],
                );
            }

            const clickHandler = () => {
                const tabValue = (btn as HTMLElement).dataset.tab;
                if (tabValue === "kommunen" || tabValue === "kategorien") {
                    switchTab(tabValue);
                } else {
                    switchTab("kommunen");
                }
            };

            (btn as HTMLElement).dataset.clickHandler =
                "clickHandler_" + Math.random().toString(36).substr(2, 9);
            btn.addEventListener(
                "click",
                () => {
                    const tabValue = (btn as HTMLElement).dataset.tab;
                    if (tabValue === "kommunen" || tabValue === "kategorien") {
                        switchTab(tabValue);
                    } else {
                        switchTab("kommunen");
                    }
                },
                { passive: true },
            );
        });

        // Swipe-Unterstützung für Mobile
        let touchStartX = 0;
        let touchEndX = 0;

        // Restore persisted tab state on page load
        document.addEventListener("DOMContentLoaded", () => {
            if (tabsInitialized) return;
            tabsInitialized = true;

            try {
                const persistedTab = getPersistedTab();
                const savedCategory = localStorage.getItem("selectedCategory");

                // Restore tab selection using precise storage key
                const tabToShow = persistedTab || "kommunen";
                switchTab(tabToShow);

                // Dispatch category selection event if saved
                if (savedCategory) {
                    setTimeout(() => {
                        // dispatchSelectCategory(category);
                    }, 100);
                }

                // Initialize EventConsole for debugging if debug=events parameter is present
                const urlParams = new URLSearchParams(window.location.search);
                if (
                    urlParams.has("debug") &&
                    urlParams.get("debug")?.includes("events")
                ) {
                    // EventConsole auto-initializes itself when imported
                    // Ensure it's accessible via window for the events module
                    if (!window.__P2D2_EVENT_CONSOLE__) {
                        console.log(
                            "[EventConsole] Manual initialization from index.astro",
                        );
                        window.__P2D2_EVENT_CONSOLE__ = new EventConsole();
                        window.__P2D2_EVENT_CONSOLE__.show();
                    }
                    if (typeof window !== "undefined") {
                        initializeCrossWindowBridge();
                        console.log(
                            "[index] Cross-window bridge initialized (main window)",
                        );
                    }
                }
            } catch (error) {
                console.warn("[index] Could not restore tab state:", error);
                switchTab("kommunen");
            }
        });

        gridContainer?.addEventListener("touchstart", (e) => {
            touchStartX = e.changedTouches[0].screenX;
        });

        gridContainer?.addEventListener("touchend", (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        });

        function handleSwipe() {
            const swipeThreshold = 50;
            const swipeDistance = touchEndX - touchStartX;

            if (Math.abs(swipeDistance) > swipeThreshold) {
                if (swipeDistance > 0) {
                    // Swipe nach rechts -> Kommunen
                    switchTab("kommunen");
                } else {
                    // Swipe nach links -> Kategorien
                    switchTab("kategorien");
                }
            }
        }
    </script>

    <style>
        .tab-button.active {
            color: rgb(17 24 39);
            border-bottom-color: rgb(79 70 229);
        }
    </style>
</BaseLayout>
