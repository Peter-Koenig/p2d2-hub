<!-- p2d2: Platzhalter-Route für die Öffentliche Verwaltung (noch im Aufbau) -->
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Für die Öffentliche Verwaltung | p2d2"
    description="Informationen für die Öffentliche Verwaltung – diese Seite befindet sich noch im Aufbau."
>
    <main class="flex flex-col items-center w-full">
        <section class="w-full max-w-6xl mx-auto px-6 py-12 text-center">
            <h1 class="font-poppins font-bold text-3xl md:text-4xl text-gray-900 mb-6">
                Für die Öffentliche Verwaltung
            </h1>
            <p class="text-lg text-gray-700 max-w-3xl mx-auto leading-relaxed mb-8">
                Diese Seite ist noch im Aufbau.
            </p>
            <p class="text-gray-700">
                Bei Rückfragen wenden Sie sich bitte an unser
                <a
                    href="/kontakt"
                    class="text-primary-600 hover:text-primary-700 font-medium underline"
                >
                    Kontaktformular
                </a>.
            </p>
        </section>
    </main>
</BaseLayout>
