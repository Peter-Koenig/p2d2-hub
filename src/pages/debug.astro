---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapCanvas from "../components/MapCanvas.astro";
import { getCollection } from "astro:content";

const kommunen = await getCollection("kommunen");
---

<BaseLayout>
    <div class="max-w-6xl mx-auto py-8 px-4">
        <h1 class="text-3xl font-bold mb-8 text-center">CRS Debug Page</h1>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Map Section -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold mb-4">Interactive Map</h2>
                <div class="h-96 border border-gray-300 rounded-lg mb-4">
                    <MapCanvas />
                </div>
                <div class="bg-blue-50 p-4 rounded-lg">
                    <h3 class="font-semibold mb-2">Current State:</h3>
                    <div id="map-state" class="text-sm">
                        Loading map state...
                    </div>
                </div>
            </div>

            <!-- Test Controls -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold mb-4">Test Controls</h2>

                <div class="space-y-4 mb-6">
                    <h3 class="font-medium">Manual Event Dispatch:</h3>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="dispatchTestEvent('koeln')" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-2 rounded text-sm">
                            Köln (25832)
                        </button>
                        <button onclick="dispatchTestEvent('berlin')" class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded text-sm">
                            Berlin (25833)
                        </button>
                        <button onclick="dispatchTestEvent('san-francisco')" class="bg-purple-500 hover:bg-purple-600 text-white px-3 py-2 rounded text-sm">
                            SF (32610)
                        </button>
                        <button onclick="dispatchTestEvent('hangzhou')" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-2 rounded text-sm">
                            Hangzhou (32650)
                        </button>
                    </div>
                </div>

                <div class="space-y-3 mb-6">
                    <h3 class="font-medium">Direct Projection Switch:</h3>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="switchToCRS('EPSG:3857')" class="bg-gray-500 hover:bg-gray-600 text-white px-3 py-2 rounded text-sm">
                            Web Mercator
                        </button>
                        <button onclick="switchToCRS('EPSG:25832')" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded text-sm">
                            UTM 32N
                        </button>
                        <button onclick="switchToCRS('EPSG:25833')" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded text-sm">
                            UTM 33N
                        </button>
                        <button onclick="switchToCRS('EPSG:32610')" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded text-sm">
                            UTM 10N
                        </button>
                    </div>
                </div>

                <div class="bg-yellow-50 p-4 rounded-lg">
                    <h3 class="font-semibold mb-2">Expected Behavior:</h3>
                    <ul class="text-sm space-y-1">
                        <li>• Click buttons should center map on city</li>
                        <li>• Projection should switch to correct UTM zone</li>
                        <li>• Toggle button should enable/disable properly</li>
                        <li>• Scale should be preserved during changes</li>
                        <li>• Check browser console for debug output</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Kommunen Data Table -->
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-4">Available Kommunen Data</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full table-auto">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2 text-left">City</th>
                            <th class="px-4 py-2 text-left">Projection</th>
                            <th class="px-4 py-2 text-left">Center</th>
                            <th class="px-4 py-2 text-left">Zoom</th>
                            <th class="px-4 py-2 text-left">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {kommunen.map((entry, index) => {
                            const m = entry.data.map || {};
                            const detail = {
                                center: m.center,
                                extent: m.extent,
                                zoom: m.zoom,
                                projection: m.projection,
                                slug: entry.slug
                            };

                            return (
                                <tr class={index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                                    <td class="px-4 py-2 font-medium">{entry.data.title}</td>
                                    <td class="px-4 py-2 font-mono text-sm">{m.projection || 'EPSG:3857'}</td>
                                    <td class="px-4 py-2 font-mono text-sm">
                                        {m.center ? `[${m.center[0].toFixed(4)}, ${m.center[1].toFixed(4)}]` : 'N/A'}
                                    </td>
                                    <td class="px-4 py-2">{m.zoom || 'N/A'}</td>
                                    <td class="px-4 py-2">
                                        <button
                                            onclick={`dispatchManualEvent(${JSON.stringify(detail)})`}
                                            class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-xs"
                                        >
                                            Test
                                        </button>
                                    </td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Test data for manual events
        const testData = {
            koeln: {
                center: [6.9603, 50.9375],
                zoom: 11,
                projection: "EPSG:25832",
                slug: "koeln"
            },
            berlin: {
                center: [13.404954, 52.520008],
                zoom: 10,
                projection: "EPSG:25833",
                slug: "berlin"
            },
            'san-francisco': {
                center: [-122.4194, 37.7749],
                zoom: 12,
                projection: "EPSG:32610",
                slug: "san-francisco"
            },
            hangzhou: {
                center: [120.1551, 30.2741],
                zoom: 11,
                projection: "EPSG:32650",
                slug: "hangzhou"
            }
        };

        function dispatchTestEvent(city) {
            const detail = testData[city];
            if (detail) {
                console.log('Dispatching test event for:', city, detail);
                window.dispatchEvent(new CustomEvent('kommunen:focus', { detail }));
            }
        }

        function dispatchManualEvent(detail) {
            console.log('Dispatching manual event:', detail);
            window.dispatchEvent(new CustomEvent('kommunen:focus', { detail }));
        }

        function switchToCRS(crs) {
            console.log('Switching to CRS:', crs);
            // This would need to be implemented in the MapCanvas component
            // For now, we'll dispatch a fake event
            window.dispatchEvent(new CustomEvent('crs:switch', {
                detail: { projection: crs }
            }));
        }

        // Listen for state updates from the map
        window.addEventListener('map:state-update', (e) => {
            const state = e.detail;
            const stateElement = document.getElementById('map-state');
            if (stateElement) {
                stateElement.innerHTML = `
                    <div><strong>Projection:</strong> ${state.projection || 'Unknown'}</div>
                    <div><strong>Center:</strong> ${state.center ? state.center.map(c => c.toFixed(2)).join(', ') : 'Unknown'}</div>
                    <div><strong>Zoom:</strong> ${state.zoom || 'Unknown'}</div>
                    <div><strong>Rotation:</strong> ${state.rotation || 0}°</div>
                `;
            }
        });

        // Auto-test after page load
        setTimeout(() => {
            console.log('Auto-test: Dispatching Köln event in 2 seconds...');
            setTimeout(() => {
                dispatchTestEvent('koeln');
            }, 2000);
        }, 1000);
    </script>

    <style>
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #e5e7eb;
            padding: 0.5rem;
        }
        th {
            background-color: #f9fafb;
            font-weight: 600;
        }
    </style>
</BaseLayout>
