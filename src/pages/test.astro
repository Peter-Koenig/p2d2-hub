---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapCanvas from "../components/MapCanvas.astro";
import { getCollection } from "astro:content";

const kommunen = await getCollection("kommunen");
const testKommune = kommunen.find(k => k.slug === "koeln") || kommunen[0];
---

<BaseLayout>
    <div class="max-w-6xl mx-auto py-8">
        <h1 class="text-3xl font-bold mb-8">CRS Functionality Test</h1>

        <div class="mb-8 p-4 bg-blue-50 rounded-lg">
            <h2 class="text-xl font-semibold mb-2">Test Instructions:</h2>
            <ol class="list-decimal list-inside space-y-1">
                <li>Click on any city card below to test CRS switching</li>
                <li>Check if the map centers correctly in the proper projection</li>
                <li>Use the toggle button to switch between UTM and Web Mercator</li>
                <li>Verify that scale is preserved during projection changes</li>
                <li>Check browser console for any errors</li>
            </ol>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <div>
                <h2 class="text-xl font-semibold mb-4">Test Cities</h2>
                <div class="space-y-4">
                    {kommunen.map((entry) => {
                        const m = entry.data.map || {};
                        const detail = {
                            center: m.center,
                            extent: m.extent,
                            zoom: m.zoom,
                            projection: m.projection,
                            slug: entry.slug
                        };

                        return (
                            <button
                                class="w-full p-4 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 text-left"
                                onclick={() => {
                                    if (typeof window !== 'undefined') {
                                        window.dispatchEvent(new CustomEvent('kommunen:focus', { detail }));
                                    }
                                }}
                            >
                                <div class="font-semibold">{entry.data.title}</div>
                                <div class="text-sm text-gray-600">
                                    Projection: {m.projection || 'EPSG:3857'}
                                </div>
                                <div class="text-xs text-gray-500">
                                    Center: {m.center?.join(', ')}
                                </div>
                            </button>
                        );
                    })}
                </div>
            </div>

            <div>
                <h2 class="text-xl font-semibold mb-4">Map Canvas</h2>
                <div class="h-96 border border-gray-200 rounded-lg">
                    <MapCanvas />
                </div>

                <div class="mt-4 p-4 bg-gray-100 rounded-lg">
                    <h3 class="font-semibold mb-2">Current Test Data:</h3>
                    <pre class="text-xs bg-white p-2 rounded border">
{JSON.stringify({
    title: testKommune.data.title,
    projection: testKommune.data.map?.projection,
    center: testKommune.data.map?.center,
    zoom: testKommune.data.map?.zoom
}, null, 2)}
                    </pre>
                </div>
            </div>
        </div>

        <div class="bg-yellow-50 p-4 rounded-lg">
            <h2 class="text-lg font-semibold mb-2">Expected Behavior:</h2>
            <ul class="list-disc list-inside space-y-1 text-sm">
                <li><strong>Köln/Bonn/Bornheim:</strong> Should switch to EPSG:25832 (UTM Zone 32N)</li>
                <li><strong>Berlin:</strong> Should switch to EPSG:25833 (UTM Zone 33N)</li>
                <li><strong>San Francisco:</strong> Should switch to EPSG:32610 (UTM Zone 10N)</li>
                <li><strong>Hangzhou:</strong> Should switch to EPSG:32650 (UTM Zone 50N)</li>
                <li><strong>Toggle Button:</strong> Should switch between local UTM and EPSG:3857</li>
                <li><strong>Scale:</strong> Should be preserved during projection changes</li>
                <li><strong>WMS:</strong> Should refresh after projection changes</li>
            </ul>
        </div>
    </div>

    <script>
        // Log events for debugging
        if (typeof window !== 'undefined') {
            window.addEventListener('kommunen:focus', (e) => {
                console.log('kommunen:focus event received', e.detail);
            });

            // Test automatic focus after load
            setTimeout(() => {
                const testDetail = {
                    center: [6.9603, 50.9375],
                    zoom: 11,
                    projection: "EPSG:25832",
                    slug: "koeln"
                };
                console.log('Dispatching test event for Köln');
                window.dispatchEvent(new CustomEvent('kommunen:focus', { detail: testDetail }));
            }, 2000);
        }
    </script>
</BaseLayout>
